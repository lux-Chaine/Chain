// ==========================================
// 🔗 تعريفات الجداول المفقودة المحتملة
// ==========================================

// جدول المدن/البلدات (للربط مع WebTown_Id)
Table Cities {
  Id bigint [pk, note: 'المُعرف الفريد للمدينة']
  Name varchar(60) [note: 'اسم المدينة']
  Country_Id bigint [note: 'رابط إلى جدول الدول']
  State_Id bigint [note: 'رابط إلى جدول الولايات']
}



// جدول حالات الفواتير (للربط مع InvoiceStatus_Id)
Table InvoiceStatuses {
  Id bigint [pk, note: 'المُعرف الفريد لحالة الفاتورة']
  ShortDescription varchar(3) [note: 'الوصف المختصر']
  LongDescription varchar(30) [note: 'الوصف الطويل']
  DisplayOrder int [note: 'ترتيب العرض']
}

// جدول دليل الهاتف (للربط مع TelephoneBook_Id)
Table TelephoneBooks {
  Id bigint [pk, note: 'المُعرف الفريد لدليل الهاتف']
  Name varchar(60) [note: 'اسم دليل الهاتف']
  Type varchar(20) [note: 'النوع']
}

// ==========================================
// 🔗 روابط الجداول الجديدة
// ==========================================

// روابط جدول المدن
Ref: Cities.Country_Id > Countries.Id
Ref: Cities.State_Id > States.Id

// روابط الجداول الجديدة مع الجداول الموجودة
Ref: CustomerAddresses.WebTown_Id > Cities.Id
Ref: Invoices.InvoiceStatus_Id > InvoiceStatuses.Id
Ref: CustomerCommunications.TelephoneBook_Id > TelephoneBooks.Id

