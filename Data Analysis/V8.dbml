}
// جدول أنواع الأجنحة أو ربط الغرف بالأجنحة (كان يسمى YCAS)
Table SuiteRoomCategories {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (YCAS_ID)']
  SuiteRoomCategory_Id bigint [not null, note: 'معرف فئة أو نوع الجناح المرتبط (YCAS_SUITE_YCAT_ID)']
  RoomCategory_Id bigint [not null, note: 'معرف فئة أو نوع الغرفة المرتبطة بالجناح (YCAS_ROOM_YCAT_ID)']
  RoomNumber int [not null, note: 'الرقم أو الترتيب المرتبط بالوحدة أو الغرفة داخل الجناح (YCAS_NUMBER)']
}
// جدول فئات أو أنواع الغرف (كان يسمى YCAT)
Table RoomCategories {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (YCAT_ID)']
  ShortDescription varchar(5) [not null, note: 'الوصف المختصر أو كود نوع الغرفة (YCAT_SHORTDESC)']
  LongDescription varchar(30) [not null, note: 'الوصف الطويل أو الاسم الكامل لفئة الغرفة (YCAT_LONGDESC)']
  DisplayOrder int [note: 'ترتيب العرض (YCAT_DISPLORDER)']
  Disabled int [note: 'مؤشر التعطيل (YCAT_DISABLED)']
  DefaultRoomCharacteristics_Id bigint [note: 'المعرف الافتراضي المرتبط (YCAT_DEFAULT_YRCH_ID)']
  DefaultNumberOfPersons int [note: 'العدد الافتراضي للأشخاص (YCAT_DEFAULTNOOFPERSONS)']
  SecondaryLink_Id bigint [note: 'معرف الربط الفرعي المساعد (YCAT_SC_YCAD_ID)']
  SumRoomType_Id bigint [note: 'معرف تجميع أنواع الغرف (YCAT_SUM_ROOMTYPE_YCAD_ID)']
  IsYieldable int [note: 'مؤشر العائد أو التسعير الديناميكي: 0 = Non Yieldable, 1 = Yieldable (YCAT_YIELDABLE)']
  RegularBeds int [note: 'عدد الأسرّة العادية لكل فئة (YCAT_NORMALBEDS)']
  ExtraBedsSpace int [note: 'عدد الأسرّة الإضافية الممكنة لكل فئة (YCAT_SPACEFOREXTRABEDS)']
  Threshold int [note: 'عدد الغرف المغلقة أمام الحجز عبر الويب (YCAT_THRESHOLD)']
  ShortWebInfo varchar(2000) [note: 'معلومات الويب المختصرة (YCAT_SHORTWEBINFO)']
  PrimarySuiteCategory_Id bigint [note: 'معرف فئة الجناح الأساسية المرتبطة (YCAT_SUITE_PRIMARY_YCAT_ID)']
  NotInAvailability int [not null, note: 'مؤشر الاستبعاد من التوفر (YCAT_NOTINAVL)']
  DontSellAlone int [not null, note: 'مؤشر منع بيع الغرفة منفردة (YCAT_DONTSELLALONE)']
  DisableMakeKey int [not null, note: 'مؤشر عدم إظهار شاشة عمل المفتاح عند التسكين (YCAT_DISABLEMAKEKEY)']
  IsSuite int [not null, note: 'مؤشر ما إذا كانت الفئة تمثل جناحاً (YCAT_SUITE)']
  MaxNumberOfPersons int [note: 'الحد الأقصى لعدد الأشخاص شامل الأطفال (YCAT_MAXNOOFPERSONS)']
  MaxToSell int [note: 'الحد الأقصى المسموح ببيعه (YCAT_MAX)']
  LongWebInfo varchar(2000) [note: 'معلومات الويب التفصيلية (YCAT_LONGWEBINFO)']
  MobileShortWebInfo varchar(1000) [note: 'معلومات الويب المختصرة للجوال (YCAT_MD_SHORTWEBINFO)']
  MobileLongWebInfo varchar(2000) [note: 'معلومات الويب التفصيلية للجوال (YCAT_MD_LONGWEBINFO)']
  ExtendedWebInfo varchar(2000) [note: 'معلومات الويب الموسعة (YCAT_EXTENDEDWEBINFO)']
  MobileExtendedWebInfo varchar(2000) [note: 'معلومات الويب الموسعة للجوال (YCAT_MD_EXTENDEDWEBINFO)']
  KeyInterface_Id bigint [note: 'معرف واجهة ربط المفاتيح (YCAT_KEYIFC_ICFG_ID)']
  MinNumberOfPersons int [note: 'الحد الأدنى لعدد الأشخاص شامل الأطفال (YCAT_MINNOOFPERSONS)']
  CategoryType int [not null, note: 'نوع الفئة: 0=Room, 1=Bed, 2=Mixed, 3=Bed only (YCAT_TYPE)']
  WebColor_Id bigint [note: 'معرف لون الويب أو العرض (YCAT_WCOL_ID)']
}




// جدول روابط أو تصنيفات الفئات (كان يسمى YCLN)
Table CategoryLinks {
  Id bigint [pk, note: 'المُعرف الفريد للجدول (YCLN_ID)']
  Detail_Id bigint [not null, note: 'مُعرف التفاصيل المرتبط بالجدول (YCLN_YDET_ID)']
  Customer_Id bigint [not null, note: 'مُعرف الجهة الخارجية أو العميل/المورّد (YCLN_XCMS_ID)']
  InternalCategory int [not null, note: 'الفئة الداخلية (YCLN_XCCA_INTERNALCATEGORY)']
}

// جدول فئات عناصر القائمة (كان يسمى YCMC)
Table MenuItemCategories {
  Id bigint [pk, note: 'مُعرف فئة عنصر القائمة (YCMC_ID)']
  LongDescription varchar(30) [not null, note: 'الوصف الطويل لفئة عناصر القائمة (YCMC_LONGDESC)']
  DisplayOrder int [note: 'ترتيب العرض لفئات عناصر القائمة (YCMC_DISPLORDER)']
  FoodOrBeverage int [not null, note: 'طعام (1) أو مشروبات (0) (YCMC_FOODORBEVERAGE)']
  Course int [note: 'دورة الوجبة المرتبطة بفئة القائمة (YCMC_COURSE)']
  MaterialCategory_Id bigint [note: 'رابط إلى فئة نظام المواد (YCMC_MC_ID)']
  Manager_Id bigint [note: 'مُعرف مدير أو ربط إضافي (YCMC_FMGR_ID)']
  Role int [note: 'دور الفئة (YCMC_ROLE)']
}
// جدول عناصر القائمة والأطعمة (كان يسمى YCMI)
Table MenuItems {
  Id bigint [pk, note: 'المُعرف الفريد لعنصر القائمة (YCMI_ID)']
  LongDescription varchar(55) [not null, note: 'الوصف الطويل لعنصر القائمة (YCMI_LONGDESC)']
  DisplayOrder int [note: 'ترتيب عرض عنصر القائمة (YCMI_DISPLORDER)']
  MenuItemCategory_Id bigint [not null, note: 'رابط إلى فئة عنصر القائمة (YCMI_YCMC_ID)']
  MinimumAmount int [note: 'الحد الأدنى للكمية المسموح ببيعها (YCMI_MINIMUMAMOUNT)']
  MaximumAmount int [note: 'الحد الأقصى للكمية المسموح ببيعها (YCMI_MAXIMUMAMOUNT)']
  Origin varchar(55) [note: 'المنشأ أو المصدر للمشروبات فقط (YCMI_ORIGIN)']
  ArticleNumber varchar(15) [note: 'رقم الصنف أو المادة (YCMI_ARTICLENUMBER)']
  CostPrice decimal(30,4) [note: 'سعر التكلفة (YCMI_COSTPRICE)']
  Portion varchar(30) [note: 'الحصة أو الجزء المباع (YCMI_PORTION)']
  LeadDays varchar(30) [note: 'عدد الأيام اللازمة لتجهيز أو طلب الصنف (YCMI_LEADDAYS)']
  AvailableFrom int [note: 'متاح بدءاً من للأصناف الموسمية (YCMI_AVAILABLEFROM)']
  AvailableUntil int [note: 'متاح حتى للأصناف الموسمية (YCMI_AVAILABLEUNTIL)']
  IncludedInMenu int [note: 'السعر مشمول في القائمة: 1 = included, 0 = not included (YCMI_INCLMENU)']
  DepartmentCode_Id bigint [not null, note: 'رابط إلى أكواد الأقسام (YCMI_ZDCO_ID)']
  LongDescription2 varchar(55) [note: 'وصف طويل إضافي ثانٍ (YCMI_LONGDESC2)']
  LongDescription3 varchar(55) [note: 'وصف طويل إضافي ثالث (YCMI_LONGDESC3)']
  LongDescription4 varchar(55) [note: 'وصف طويل إضافي رابع (YCMI_LONGDESC4)']
  Origin2 varchar(55) [note: 'منشأ إضافي ثانٍ (YCMI_ORIGIN2)']
  Origin3 varchar(55) [note: 'منشأ إضافي ثالث (YCMI_ORIGIN3)']
  Vintage varchar(4) [note: 'سنة الإنتاج أو العتيق للنبيذ (YCMI_VINTAGE)']
  Description text [note: 'وصف تفصيلي لعنصر القائمة (YCMI_DESCRIPTION)']
  Inactive int [note: 'مؤشر التعطيل: 0 = active, 1 = inactive (YCMI_INACTIVE)']
  MaterialControlDescription varchar(60) [note: 'الوصف الطويل لمنتج نظام المواد (YCMI_MC_LONGDESC)']
  MaterialControlInterface_Id bigint [note: 'رابط واجهة نظام المواد بنقاط البيع (YCMI_MC_POS_IFC)']
  ControlType int [note: 'نوع التحكم: 0 = CCM, 1 = Materials Control (YCMI_TYPE)']
  WebConfig_Id bigint [note: 'ربط تعريف عنصر القائمة مع إعدادات الويب (YCMI_YCWI_ID)']
}
// جدول أكواد الأسعار أو التعاميم (كان يسمى YCRT)
Table RateCodes {
  Id bigint [pk, note: 'المُعرف الفريد لكود السعر (YCRT_ID)']
  ShortDescription varchar(5) [not null, note: 'الوصف المختصر أو الكود المختصر (YCRT_SHORTDESC)']
  LongDescription varchar(200) [not null, note: 'الوصف الطويل لكود السعر (YCRT_LONGDESC)']
  Customer_Id bigint [note: 'مُعرف الجهة أو العميل المرتبط (YCRT_XCMA_ID)']
  RoomCategory_Id bigint [note: 'مُعرف الفئة المرتبطة (YCRT_YCAT_ID)']
  ReservationRateCode_Id bigint [note: 'كود السعر المخصص للحجوزات (YCRT_YRCH_ID)']
  ContractRateCode_Id bigint [note: 'كود السعر الخاص برسوم العقود السنوية (YCRT_CONTRACT_YRCH_ID)']
  WeekStartType int [note: 'نوع بداية الأسبوع: 0 = calendar, 1 = weekday instance (YCRT_WEEKSTARTTYPE)']
  WeekStartValue int [note: 'قيمة بداية الأسبوع (YCRT_WEEKSTARTVALUE)']
  Inactive int [note: 'مؤشر التعطيل (YCRT_INACTIVE)']
  DisplayOrder int [not null, note: 'ترتيب العرض (YCRT_DISPLORDER)']
  WebColor_Id bigint [note: 'مُعرف عمود الويب أو التنسيق المرتبط (YCRT_WCOL_ID)']
  MandatoryContractNumber int [note: 'يحدد ما إذا كان رقم العقد إجبارياً (YCRT_MANDATORYCONTRACTNUMBER)']
  SourceRateAssociation_Id bigint [note: 'المصدر المرتبط (YCRT_SOURCE_YRAS_ID)']
  Company_Id bigint [note: 'مُعرف الشركة المرتبطة (YCRT_COMPANY_XCMS_ID)']
  SourceCustomer_Id bigint [note: 'مُعرف جهة المصدر (YCRT_SOURCE_XCMS_ID)']
  TravelAgent_Id bigint [note: 'مُعرف وكيل السفر المرتبط (YCRT_TRAVELAGENT_XCMS_ID)']
}


// جدول تفاصيل الحجز اليومية (كان يسمى YDET)
Table ReservationDetails {
  Id bigint [pk, note: 'المُعرف الفريد لسجل تفاصيل الحجز اليومي (YDET_ID)']
  Reservation_Id bigint [not null, note: 'رابط إلى رأس الحجز الأساسي (YDET_YRES_ID)']
  DetailDate timestamp [not null, note: 'تاريخ اليوم المعني بالتفاصيل (YDET_DATE)']
  RateCode_Id bigint [note: 'رابط إلى جدول كود السعر (YDET_YRCH_ID)']
  MarketCode_Id bigint [note: 'رابط إلى كود السوق (YDET_XCMA_ID)']
  AdultCount int [note: 'عدد البالغين (YDET_ADULTNO)']
  NumberOfRooms int [note: 'عدد الغرف لهذه الليلة (YDET_NOOFROOMS)']
  ShareNumber bigint [note: 'رقم المشاركة للحجوزات المشتركة (YDET_SHARENUM)']
  Room_Id bigint [note: 'رابط إلى جدول إعداد الغرف (YDET_YRMS_ID)']
  RoomCategory_Id bigint [note: 'رابط إلى جدول إعداد أنواع الغرف (YDET_YCAT_ID)']
  RateRoomCategory_Id bigint [not null, note: 'فئة الغرفة الأساسية لحساب السعر (YDET_YCAT_ID_RATE)']
  BlockDetail_Id bigint [note: 'مُعرف المبنى أو تفاصيل الكتلة (YDET_YBLD_ID)']
  Group_Id bigint [note: 'مُعرف المجموعة (YDET_YGRP_ID)']
  ExpectedRoomMoveTime timestamp [note: 'وقت الانتقال المتوقع للغرفة (YDET_EXPROOMMOVETIME)']
  ActualRoomMoveTime timestamp [note: 'وقت الانتقال الفعلي للغرفة (YDET_ACTROOMMOVETIME)']
  RateAmount decimal(30,4) [note: 'مبلغ أو قيمة السعر (YDET_RATEAMOUNT)']
  RateDifference decimal(30,4) [note: 'فرق السعر اليدوي المضاف (YDET_RATEDIFF)']
  ManualRate decimal(30,4) [note: 'السعر اليدوي البديل (YDET_RATEMANUAL)']
  ForeignRateAmount decimal(30,4) [note: 'مبلغ السعر بالعملة الأجنبية (YDET_FOREIGNRATEAMOUNT)']
  ForeignRateDifference decimal(30,4) [note: 'فرق السعر بالعملة الأجنبية (YDET_FOREIGNRATEDIFF)']
  ForeignManualRate decimal(30,4) [note: 'السعر اليدوي بالعملة الأجنبية (YDET_FOREIGNRATEMANUAL)']
  NetAmount decimal(30,4) [note: 'مبلغ الصافي (YDET_NETAMOUNT)']
  NetForeignAmount decimal(30,4) [note: 'مبلغ الصافي بالعملة الأجنبية (YDET_NETFOREIGNAMOUNT)']
  Breakfast int [note: 'مؤشر وجبة الإفطار (YDET_BREAKFAST)']
  Lunch int [note: 'مؤشر وجبة الغداء (YDET_LUNCH)']
  Dinner int [note: 'مؤشر وجبة العشاء (YDET_DINNER)']
  RateModifier decimal(30,4) [note: 'معدل تعديل السعر (YDET_RATEMODIFIER)']
  ForeignRateModifier decimal(30,4) [note: 'معدل تعديل السعر بالعملة الأجنبية (YDET_FOREIGNRATEMODIFIER)']
  FreeNights_Id bigint [note: 'رابط إلى جدول الليالي المجانية (YDET_YFRN_ID)']
  SuiteRoomCategory_Id bigint [note: 'مُعرف فئة الجناح المرتبط (YDET_SUITE_YCAT_ID)']
  SuiteRoom_Id bigint [note: 'مُعرف غرفة الجناح المرتبط (YDET_SUITE_YRMS_ID)']
  NoDiscountPackage decimal(30,4) [note: 'حزمة الخصم غير المطبقة (YDET_NODISCOUNTPACKAGE)']
}



// جدول عروض أو تخفيضات الحجوزات (يسمى YLPR)
Table ReservationPromotions {
  Id bigint [pk, note: 'المُعرف الفريد لسجل العرض بالحجز (YLPR_ID)']
  ReservationDetail_Id bigint [not null, note: 'رابط إلى تفاصيل الحجز (YLPR_YDET_ID)']
  Promotion_Id bigint [not null, note: 'رابط إلى جدول العروض الترويجية (YLPR_YPRM_ID)']
  PromotionRuleLink_Id bigint [not null, note: 'رابط إلى جدول ربط قواعد العروض (YLPR_YPRR_ID)']
  Amount decimal(30,4) [note: 'قيمة مبلغ العرض المخزن على مستوى الحجز لكل قاعدة ترويجية (YLPR_AMOUNT)']
  ForeignAmount decimal(30,4) [note: 'مبلغ العرض بالعملة الأجنبية المخزن على مستوى الحجز لكل قاعدة ترويجية (YLPR_FOREIGNAMOUNT)']
}

// جدول عمليات أو قيود نقاط البيع للحجوزات (يسمى YPOS)
Table ReservationPosPostings {
  Id bigint [pk, note: 'المُعرف الفريد لسجل حركة نقاط البيع (YPOS_ID)']
  ExternalConfig_Id bigint [not null, note: 'رابط إلى إعدادات النظام الخارجية أو المشتركة (YPOS_XCMS_ID)']
  Reservation_Id bigint [not null, note: 'رابط إلى جدول الحجوزات (YPOS_YRES_ID)']
  PostingDate date [not null, note: 'تاريخ حركة نقاط البيع (YPOS_DATE)']
  DepartmentCode_Id bigint [not null, note: 'رابط إلى كود القسم المحاسبي (YPOS_ZDCO_ID)']
  UnitPrice decimal(30,4) [not null, note: 'سعر الوحدة (YPOS_UNITPRICE)']
  Quantity int [not null, note: 'الكمية (YPOS_QUANTITY)']
  TaxLink_Id bigint [not null, note: 'رابط جدول الضرائب (YPOS_TAXLINK_ID)']
  InternalSplit_Id bigint [not null, note: 'معرف الانقسام الداخلي للحركة (YPOS_INTERNALSPLIT_ID)']
  TransactionType int [note: 'نوع الحركة المالية: 1 = Debit, 2 = Tax (YPOS_DT)']
  PostingType int [not null, note: 'نوع القيد: 0 = normal, 1 = fixed charges, 2 = package related (YPOS_TYPE)']
  RateModifier decimal(30,4) [note: 'معامل تعديل السعر (YPOS_RATEMODIFIER)']
  GrossUnitPrice decimal(30,4) [note: 'سعر الوحدة الإجمالي (YPOS_GROSSUNITPRICE)']
  Currency_Id bigint [not null, note: 'رابط العملة (YPOS_ZCUR_ID)']
  ForeignUnitPrice decimal(30,4) [note: 'سعر الوحدة بالعملة الأجنبية (YPOS_FOREIGNUNITPRICE)']
  ForeignGrossUnitPrice decimal(30,4) [note: 'السعر الإجمالي للوحدة بالعملة الأجنبية (YPOS_FOREIGNGROSSUNITPRICE)']
  BillingPeriod int [not null, note: 'فترة الفوترة (YPOS_BILLINGPERIOD)']
  AccountConfig_Id bigint [note: 'رابط قواعد أو إعدادات الحساب (YPOS_ZARR_ID)']
  TaxCode_Id bigint [note: 'رابط كود الضريبة أو المعاملة (YPOS_ZTCD_ID)']
}


// جدول إدارة العروض أو الحزم الترويجية (يسمى YPRM)
Table Promotions {
  Id bigint [pk, note: 'المُعرف الفريد لسجل العرض أو الحزمة الرئيسية (YPRM_ID)']
  PromotionCategory_Id bigint [note: 'رابط إلى فئة أو تصنيف الحزم (YPRM_YPRC_ID)']
  ShortDesc varchar(3) [not null, note: 'الوصف المختصر للعرض أو الحزمة (YPRM_SHORTDESC)']
  LongDesc varchar(30) [not null, note: 'الوصف الطويل أو اسم العرض (YPRM_LONGDESC)']
  StartDate date [note: 'تاريخ بداية توفر العرض الترويجي (YPRM_STARTDATE)']
  EndDate date [note: 'تاريخ نهاية توفر العرض الترويجي (YPRM_ENDDATE)']
  DisplayOrder int [note: 'ترتيب عرض العرض أو الحزمة (YPRM_DISPLORDER)']
  Exclusive int [note: 'مؤشر الاستثناء أو الأولوية العليا (YPRM_EXCLUSIVE)']
  Inactive int [note: 'حالة التفعيل: 0 = Active, 1 = Inactive (YPRM_INACTIVE)']
  StayDateRange int [note: 'مؤشر تطبيق نطاق التواريخ على فترة الإقامة بالكامل (YPRM_STAYDATERANGE)']
  WebDesc varchar(100) [note: 'وصف العرض المخصص للويب (YPRM_WEBDESC)']
  WebEnabled int [note: 'مؤشر تفعيل ظهور العرض على منصات الويب (YPRM_WEBENABLED)']
  WebLongDesc varchar(1000) [note: 'الوصف الطويل المخصص للويب (YPRM_WEBLONG)']
}

// جدول شروط الحجوزات أو تصنيفات أسباب الإلغاء/الأنواع (يسمى YRAC)
Table ReservationCriteriaCodes {
  Id bigint [pk, note: 'المُعرف الفريد لسجل المعيار أو السبب (YRAC_ID)']
  ShortDesc varchar(3) [not null, note: 'الوصف المختصر (YRAC_SHORTDESC)']
  LongDesc varchar(30) [not null, note: 'الوصف الطويل أو الاسم (YRAC_LONGDESC)']
  DisplayOrder int [note: 'ترتيب العرض (YRAC_DISPLORDER)']
  ResOrDet int [note: 'نوع الارتباط: 1 = مرتبط بالحجوزات YRES، 0 = مرتبط بالتفاصيل YDET (YRAC_RESORDET)']
  SingleSelect int [not null, note: 'خيار الاختيار الفردي: 1 = عنصر واحد، 0 = متعدد (YRAC_SINGLESELECT)']
  ShowRes int [note: 'إمكانية الرؤية في شاشة تعديل الحجز (YRAC_SHOWRES)']
  MandatoryRes int [note: 'إلزامية التحقق في شاشة تعديل الحجز (YRAC_MANDATORYRES)']
  ShowAccounts int [note: 'إمكانية الرؤية في شاشة الحسابات المالية (YRAC_SHOWACCOUNTS)']
  MandatoryAccounts int [note: 'إلزامية التحقق في شاشة الحسابات المالية (YRAC_MANDATORYACCOUNTS)']
}


// جدول ربط تفاصيل الحجوزات أو الحسابات بمعايير الأسباب والأكواد (يسمى YRAL)
Table ReservationReasonLinks {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الربط (YRAL_ID)']
  ReservationDetail_Id bigint [not null, note: 'رابط إلى جدول تفاصيل الحجز (YRAL_YDET_ID)']
  ReservationAccountSummary_Id bigint [not null, note: 'رابط إلى جدول الحجوزات أو المجموعات (YRAL_YRAS_ID)']
  CriteriaCode_Id bigint [not null, note: 'رابط إلى جدول معايير وأكواد الأسباب (YRAL_YRAC_ID)']
}
// جدول مصادر الحجوزات أو قنوات الحجز (يسمى YRAS)
Table ReservationSources {
  Id bigint [pk, note: 'المُعرف الفريد لسجل مصدر الحجز (YRAS_ID)']
  CriteriaCode_Id bigint [not null, note: 'رابط إلى جدول المعايير أو الأكواد المرتبطة (YRAS_YRAC_ID)']
  ShortDesc varchar(3) [not null, note: 'الوصف المختصر لمصدر الحجز (YRAS_SHORTDESC)']
  LongDesc varchar(30) [not null, note: 'الوصف الطويل أو اسم مصدر الحجز (YRAS_LONGDESC)']
  DisplayOrder int [note: 'ترتيب عرض مصدر الحجز (YRAS_DISPLORDER)']
  SourceGroup_Id bigint [note: 'رابط إلى جدول المجموعات أو التصنيفات الخاصة بمصادر الحجز (YRAS_YRAG_ID)']
  Inactive int [note: 'مؤشر التعطيل (YRAS_INACTIVE)']
  DefaultRes int [note: 'تحديد ما إذا كان هذا المصدر افتراضياً للحجوزات الجديدة (YRAS_DEFAULT_RES)']
  DefaultCcm int [note: 'تعيين المصدر الافتراضي لحجوزات الـ CCM (YRAS_DEFAULT_CCM)']
}

// جدول إدارة رموز أو تصنيفات شروط معينة (يسمى YRCC)
Table ReservationCodes {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الرمز (YRCC_ID)']
  ShortDesc varchar(3) [not null, note: 'الوصف المختصر للرمز (YRCC_SHORTDESC)']
  LongDesc varchar(30) [not null, note: 'الوصف الطويل للرمز (YRCC_LONGDESC)']
  DisplayOrder int [note: 'ترتيب العرض الخاص بالرمز (YRCC_DISPLORDER)']
}

// جدول تفاصيل الأسعار أو أكواد الأسعار (يسمى YRCD)
Table RateCodeDetails {
  Id bigint [pk, note: 'المُعرف الفريد لسجل تفاصيل السعر (YRCD_ID)']
  RateCodeHeader_Id bigint [not null, note: 'رابط إلى جدول رأس كود السعر (YRCD_YRCH_ID)']
  RateSeason_Id bigint [note: 'رابط لمواسم الأسعار (YRCD_YRSE_ID)']
  StartDate date [not null, note: 'تاريخ البداية لصلاحية تفاصيل السعر (YRCD_STARTDATE)']
  EndDate date [not null, note: 'تاريخ النهاية لصلاحية تفاصيل السعر (YRCD_ENDDATE)']
  MarketCode_Id bigint [note: 'كود السوق الافتراضي (YRCD_XCMA_ID)']
  RateModifierPerPersonPerNight decimal(30,4) [note: 'معدل تعديل السعر لكل شخص في الليلة (YRCD_PPPN)']
  RateModifierPerPersonPerStay decimal(30,4) [note: 'معدل تعديل السعر لكل شخص في الإقامة (YRCD_PPPS)']
  RateModifierPerRoomPerNight decimal(30,4) [note: 'معدل تعديل السعر لكل غرفة في الليلة (YRCD_PRPN)']
  RateModifierPerRoomPerStay decimal(30,4) [note: 'معدل تعديل السعر لكل غرفة في الإقامة (YRCD_PRPS)']
  Promotion_Id bigint [note: 'العرض الترويجي المرتبط (YRCD_YPRM_ID)']
  BaseType int [note: 'نوع السعر الأساسي: 0 = نسبة، 1 = خصم (YRCD_BASE_TYPE)']
  BaseRounding int [note: 'طريقة تقريب قيم الأسعار (YRCD_BASE_ROUNDING)']
  BaseValue decimal(10,4) [note: 'قيمة السعر الأساسي (YRCD_BASE_VALUE)']
  SourceCode_Id bigint [note: 'كود مصدر العميل (YRCD_YRAS_ID)']
  WeekendBaseType int [note: 'نوع السعر الأساسي لعطلة نهاية الأسبوع (YRCD_BASE_TYPE_WE)']
  WeekendBaseRounding int [note: 'قاعدة تقريب أسعار عطلة نهاية الأسبوع (YRCD_BASE_ROUNDING_WE)']
  WeekendBaseValue decimal(10,4) [note: 'قيمة السعر الأساسي لعطلة نهاية الأسبوع (YRCD_BASE_VALUE_WE)']
}


// جدول رأس أكواد الأسعار (يسمى YRCH)
Table RateCodeHeaders {
  Id bigint [pk, note: 'المُعرف الفريد لرأس كود السعر (YRCH_ID)']
  RateCategory_Id bigint [not null, note: 'رابط إلى فئة كود السعر (YRCH_YRCC_ID)']
  ShortDesc varchar(10) [not null, note: 'الوصف المختصر أو كود السعر نفسه (YRCH_SHORTDESC)']
  LongDesc varchar(30) [not null, note: 'الوصف الطويل لكود السعر (YRCH_LONGDESC)']
  DisplayOrder int [note: 'ترتيب العرض (YRCH_DISPLORDER)']
  FolioText varchar(60) [note: 'النص الذي سيطبع على فاتورة النزيل (YRCH_FOLIOTEXT)']
  MarketCode_Id bigint [note: 'كود السوق الافتراضي (YRCH_XCMA_ID)']
  DepartmentCode_Id bigint [note: 'كود القسم للسعر العادي (YRCH_ZDCO_ID)']
  WeekendDepartmentCode_Id bigint [note: 'كود القسم لسعر عطلة نهاية الأسبوع (YRCH_WEEKEND_ZDCO_ID)']
  StartSell date [note: 'تاريخ بداية نطاق البيع (YRCH_STARTSELL)']
  EndSell date [note: 'تاريخ نهاية نطاق البيع (YRCH_ENDSELL)']
  MinLos int [note: 'الحد الأدنى للإقامة (YRCH_MIN_LOS)']
  MaxLos int [note: 'الحد الأقصى للإقامة (YRCH_MAX_LOS)']
  AdvBook int [note: 'عدد أيام الحجز المسبق المطلوبة (YRCH_ADV_BOOK)']
  Rhythm int [note: 'إيقاع السعر: 0=يومي، 1=أسبوعي، 2=شهري، 3=سنوي، 4=ثابت (YRCH_RHYTHM)']
  RateInfo varchar(2000) [note: 'وصف تسويقي للأسعار لـ Hotelbank (YRCH_RATEINFO)']
  IsPublic int [note: 'مؤشر ما إذا كان السعر عاماً (YRCH_PUBLIC)']
  PrintRate int [note: 'طباعة السعر على بطاقة التسجيل REGCARD (YRCH_PRINTRATE)']
  CompStatus int [note: 'حالة المجاملة: 1=Complimentary، 2=House Status (YRCH_COMPSTATUS)']
  SelectOrder int [note: 'ترتيب عرض توفر الأسعار (YRCH_SELECTORDER)']
  BoardType int [note: 'نوع وجبة الإقامة (0=بدون، 1=إفطار، 2=إفطار وغداء، 3=إفطار وعشاء، 4=كاملة، 5=شامل الكل) (YRCH_BOARDTYPE)']
  WeekendMon int [note: 'تحديد يوم الإثنين كعطلة أسبوعية (YRCH_WEEKEND_MON)']
  WeekendTue int [note: 'تحديد يوم الثلاثاء كعطلة أسبوعية (YRCH_WEEKEND_TUE)']
  WeekendWed int [note: 'تحديد يوم الأربعاء كعطلة أسبوعية (YRCH_WEEKEND_WED)']
  WeekendThu int [note: 'تحديد يوم الخميس كعطلة أسبوعية (YRCH_WEEKEND_THU)']
  WeekendFri int [note: 'تحديد يوم الجمعة كعطلة أسبوعية (YRCH_WEEKEND_FRI)']
  WeekendSat int [note: 'تحديد يوم السبت كعطلة أسبوعية (YRCH_WEEKEND_SAT)']
  WeekendSun int [note: 'تحديد يوم الأحد كعطلة أسبوعية (YRCH_WEEKEND_SUN)']
  Currency_Id bigint [note: 'العملة الأجنبية (YRCH_ZCUR_ID)']
  Yieldable int [note: 'قابلية العائد (0=غير قابل، 1=قابل بالكامل، 2=حسب نمط الإقامة) (YRCH_YIELDABLE)']
  Pppn decimal(30,4) [note: 'معدل السعر لكل شخص في الليلة (YRCH_PPPN)']
  Ppps decimal(30,4) [note: 'معدل السعر لكل شخص في الإقامة بالكامل (YRCH_PPPS)']
}
// جدول ربط الأسعار بالباقات أو الحزم (يسمى YRCP)
Table RateCodePackageLinks {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الربط (YRCP_ID)']
  RateCodeHeader_Id bigint [not null, note: 'رابط إلى رأس كود السعر (YRCP_YRCH_ID)']
  Package_Id bigint [not null, note: 'رابط إلى جدول الباقات أو الحزم (YRCP_YPAC_ID)']
  Frequency_Id bigint [not null, note: 'رابط إضافي لتفاصيل الباقة أو التردد (YRCP_YPFR_ID)']
  IsInvalid int [note: 'مؤشر ما إذا كان هذا الربط غير صالح أو ملغياً (YRCP_INVALID)']
}
// جدول قيم أسعار الأفراد أو مصفوفة الأسعار (يسمى YRCV)
Table RateCodeMatrixValues {
  Id bigint [pk, note: 'المُعرف الفريد لسجل مصفوفة الأسعار (YRCV_ID)']
  RateCodeDetail_Id bigint [not null, note: 'رابط إلى تفاصيل كود السعر (YRCV_YRCD_ID)']
  NoOfAdults int [not null, note: 'عدد البالغين المُدخل في شاشة تعديل المصفوفة (YRCV_NOOFADULTS)']
  Value decimal(30,4) [not null, note: 'القيمة الخاصة بالبالغين (YRCV_VALUE)']
  IsDefault int [note: 'تفاصيل السعر الافتراضية: 0=لا، 1=نعم (YRCV_DEFAULT)']
  WeekendValue decimal(30,4) [note: 'السعر الخاص بأيام العطلة الأسبوعية (YRCV_WEEKEND_VALUE)']
  DayNum int [note: 'مُعرف اليوم لحساب السعر بطريقة روبنسون (YRCV_DAYNUM)']
}


// جدول قيم أسعار الأطفال أو شروط فئات الأطفال في المصفوفة (يسمى YRCX)
Table RateCodeChildMatrixValues {
  Id bigint [pk, note: 'المُعرف الفريد لسجل جدول YRCX (YRCX_ID)']
  ControlCategory_Id bigint [not null, note: 'رابط إلى جدول فئات التحكم أو الأعمار (YRCX_XCAC_ID)']
  NoOfChilds int [not null, note: 'عدد الأطفال (YRCX_NOOFCHILDS)']
  Value decimal(30,4) [not null, note: 'القيمة المرتبطة بالسعر أو التعديل (YRCX_VALUE)']
  RateCodeMatrixValue_Id bigint [not null, note: 'رابط إلى جدول قيم مصفوفة الأسعار الرئيسية YRCV (YRCX_YRCV_ID)']
  IsDefault int [note: 'تفاصيل السعر الافتراضية: 0=لا، 1=نعم (YRCX_DEFAULT)']
  WeekendValue decimal(30,4) [note: 'قيمة السعر الخاصة بأيام العطلة الأسبوعية (YRCX_WEEKEND_VALUE)']
}

// جدول تقويم تفاصيل الأسعار أو قيم التقويم المرتبطة بالتفاصيل (يسمى YRDC)
Table RateDetailCalendars {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (YRDC_ID)']
  RateDetail_Id bigint [note: 'رابط إلى جدول تفاصيل السعر أو الحجز (YRDC_YRD_ID)']
  CalendarDate date [note: 'التاريخ المرتبط بالسجل (YRDC_DATE)']
  IsAutomatic int [note: 'مؤشر التعيين التلقائي: 1=تلقائي، 0=يدوي (YRDC_AUTOMATIC)']
  CalendarValue_Id bigint [not null, default: 0, note: 'رابط قيمة تقويم نوع اليوم بشرائح الفندق (YRDC_YCAD_ID)']
}
// جدول تفاصيل بيانات أو خيارات مرتبطة بالحجوزات أو الإقامات (يسمى YRDD)
Table ReservationDetailData {
  Id bigint [pk, note: 'المُعرف الفريد لسجل جدول YRDD (YRDD_ID)']
  RateDetail_Id bigint [note: 'رابط إلى جدول التفاصيل المرتبط (YRDD_YRDT_ID)']
  DetailStatus_Id bigint [note: 'رابط إلى جدول المجموعات أو البيانات المرتبطة (YRDD_YRDS_ID)']
  IsAverage int [note: 'مؤشر المتوسط (YRDD_AVERAGE)']
  IsFirstDay int [note: 'مؤشر اليوم الأول (YRDD_FIRSTDAY)']
  Type int [note: 'نوع السجل أو التصنيف (YRDD_TYPE)']
}
// جدول تفاصيل تواريخ أنواع الأيام (يسمى YRDE)
Table DaytypeDetailDates {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (YRDE_ID)']
  ReservationDetailData_Id bigint [not null, note: 'رابط إلى جدول بيانات التفاصيل المرتبط YRDD (YRDE_YRDD_ID)']
  StartDate date [note: 'تاريخ بداية تفاصيل نوع اليوم، إذا كان فارغاً فهو صالح للأوقات الماضية (YRDE_STARTDATE)']
  EndDate date [note: 'تاريخ نهاية تفاصيل نوع اليوم، إذا كان فارغاً فهو صالح للمستقبل (YRDE_ENDDATE)']
}
// جدول مكالمات الإيقاظ أو التنبيهات المرتبطة بتفاصيل الحجز (يسمى YRDF)
Table ReservationDetailWakeupCalls {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (YRDF_ID)']
  Detail_Id bigint [not null, note: 'رابط إلى سجل التفاصيل المقابل في جدول YDET (YRDF_YDET_ID)']
  WakeupTime varchar(10) [note: 'وقت أو تفاصيل مكالمة الإيقاظ (YRDF_WAKEUP)']
}
// جدول ربط تفاصيل الأسعار بالحزم أو الباقات (يسمى YRDP)
Table RateDetailPackageLinks {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (YRDP_ID)']
  RateCodeDetail_Id bigint [not null, note: 'رابط إلى جدول تفاصيل كود السعر (YRDP_YRCD_ID)']
  Package_Id bigint [not null, note: 'رابط إلى جدول الباقات أو الحزم (YRDP_YPAC_ID)']
  PackageFrequency_Id bigint [not null, note: 'رابط إلى تفاصيل تردد أو هيكل الباقة (YRDP_YPFR_ID)']
  IsInvalid int [note: 'مؤشر ما إذا كان ارتباط الباقة بتفاصيل السعر غير صالح (YRDP_INVALID)']
}


// جدول ربط تفاصيل أو أنواع الحجوزات (يسمى YRDY)
Table ReservationDetailLinks {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (YRDY_ID)']
  ObsoleteDetailData_Id bigint [note: 'عمود قديم أو مهمل لم يعد مستخدماً (YRDY_YRDD_ID)']
  RoomCategory_Id bigint [note: 'رابط إلى جدول فئات أو أنواع الغرف (YRDY_YCAT_ID)']
  DaytypeDetailDate_Id bigint [note: 'رابط إلى جدول تفاصيل تواريخ أنواع الأيام (YRDY_YRDE_ID)']
}



// جدول الحجوزات الأساسي (يسمى YRES)
Table ReservationsMaster {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الحجز (YRES_ID)']
  MasterBooking_Id bigint [note: 'رابط إلى جدول الحجز الرئيسي في قاعدة بيانات حجز الماستر (YRES_YBOM_ID)']
  GuestProfile_Id bigint [note: 'الرابط الرئيسي لقاعدة بيانات الملف الشخصي للنزيل (YRES_XCMS_ID)']
  ExpectedArrival timestamp [not null, note: 'تاريخ ووقت الوصول المتوقع (YRES_EXPARRTIME)']
  ActualArrival timestamp [note: 'تاريخ ووقت الوصول الفعلي لحظة تسجيل الوصول (YRES_ACTARRTIME)']
  ExpectedDeparture timestamp [not null, note: 'تاريخ ووقت المغادرة المتوقع (YRES_EXPDEPTIME)']
  ActualDeparture timestamp [note: 'تاريخ ووقت المغادرة الفعلي لحظة تسجيل المغادرة (YRES_ACTDEPTIME)']
  CrsReservationNo varchar(50) [note: 'رقم حجز فريد قادم من نظام حجز CRS (YRES_CRSRESNR)']
  CrsSystem varchar(30) [note: 'مُعرف نظام CRS الذي نشأ منه الحجز (YRES_CRSSYSTEM)']
  HasShare int [note: 'يشير إلى وجود مشاركة الغرفة أثناء الإقامة: 0=لا، 1=نعم (YRES_HASSHARE)']
  GuaranteeType_Id bigint [note: 'رابط إلى ضمان الحجز (YRES_YGCO_ID)']
  ReservationStatus int [not null, note: 'حالة الحجز: 0=مبدئي، 1=مؤكد، 2=مستقبل (YRES_RESSTATUS)']
  Requested varchar(10) [note: 'الطلبات الخاصة بالحجز (YRES_REQUESTED)']
  LastFixedPostTime timestamp [note: 'آخر تاريخ لترحيل الرسوم الثابتة (YRES_LASTFIXPOSTTIME)']
  DefaultPaymentMethod_Id bigint [note: 'طريقة الدفع الافتراضية للحجز (YRES_DEFPAYMETH_ZDCO_ID)']
  NoAvailabilityReason int [note: 'سبب عدم تأثير الحجز على الإتاحة: 1=قائمة انتظار، 2=عرض، 3=ملغي (YRES_NOAVAILREASON)']
  PreviousReservationStatus int [note: 'حالة الحجز السابقة (YRES_PREVRESSTATUS)']
  NoPost int [note: 'مؤشر منع الترحيل: 0=مسموح، 1=ممنوع (YRES_NOPOST)']
  VideoCheckoutAllowed int [note: 'السماح بالخروج عبر الفيديو (YRES_VID_CHKO)']
  IsWalkIn int [not null, note: 'مؤشر حجز Walk-in: 0=عادي، 1=Walkin (YRES_WALKIN)']
  DisplayColor_Id bigint [note: 'لون العرض في لوحة الغرف (YRES_WCOL_ID)']
  Group_Id bigint [note: 'رابط إلى جدول المجموعات (YRES_YGRP_ID)']
  ContractCurrency_Id bigint [note: 'رابط العملة التعاقدية للحجز (YRES_CONTRACT_ZCUR_ID)']
  ContractExchangeRate decimal(38,18) [note: 'سعر الصرف التعاقدي (YRES_CONTRACT_EXCHRATE)']
  ConfirmationNo varchar(10) [not null, note: 'رقم تأكيد الحجز (YRES_CONFIRMATIONNO)']
  RateDifferenceReason varchar(30) [note: 'سبب اختلاف السعر (YRES_RATEDIFFREASON)']
  IsVacant int [note: 'مؤشر مغادرة النزيل الغرفة دون دفع الفاتورة (YRES_VACANT)']
  PrintRate int [note: 'طباعة السعر على بطاقة التسجيل: 1=طباعة (YRES_PRINTRATE)']
  CreditStatus int [note: 'حقل قديم لم يعد مستخدماً (YRES_CREDITSTAT)']
  ShareType int [note: 'نوع المشاركة: 0=مستقل، 1=رئيسي، 2=تابع (YRES_SHARETYPE)']
  FreeText1 varchar(100) [note: 'حقل نصي حر أول للأغراض المرنة (YRES_FREETEXT1)']
  FreeText2 varchar(100) [note: 'حقل نصي حر ثانٍ (YRES_FREETEXT2)']
}




// جدول خطوط أو تفاصيل الأعمار المرتبطة بتفاصيل الحجز (يسمى YRGL)
Table ReservationDetailAgeLines {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (YRGL_ID)']
  Detail_Id bigint [not null, note: 'الرابط إلى جدول تفاصيل الحجز (YRGL_YDET_ID)']
  AgeControl_Id bigint [not null, note: 'الرابط إلى جدول التحكم في الأعمار أو الفئات (YRGL_XCAC_ID)']
  AgeNumber int [not null, note: 'عدد العمر المختار لسجل تفاصيل الحجز المحدد (YRGL_NUMBER)']
}

// جدول ربط الغرف بالخصائص أو السمات (يسمى YRKR)
Table RoomAttributeLinks {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (YRKR_ID)']
  Attribute_Id bigint [not null, note: 'رابط إلى جدول الخصائص أو السمات (YRKR_XPDA_ID)']
  Room_Id bigint [not null, note: 'رابط إلى جدول الغرف (YRKR_YRMS_ID)']
}

// جدول الغرف الرئيسي (يسمى YRMS)
Table Rooms {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الغرفة (YRMS_ID)']
  RoomCategory_Id bigint [not null, note: 'رابط إلى جدول أنواع الغرف YCAT (YRMS_YCAT_ID)']
  RoomNumber varchar(10) [not null, note: 'رقم أو الوصف المختصر للغرفة نفسه (YRMS_SHORTDESC)']
  LongDesc varchar(30) [not null, note: 'الوصف الطويل للغرفة (YRMS_LONGDESC)']
  DisplayOrder int [note: 'عداد لترتيب عرض الغرف المخصص (YRMS_DISPLORDER)']
  ValidFrom date [not null, note: 'تاريخ بداية الصلاحية (YRMS_VALIDFROM)']
  ValidUntil date [not null, note: 'تاريخ نهاية الصلاحية (YRMS_VALIDUNTIL)']
  OriginalRecordRoom_Id bigint [note: 'رابط لسجل الغرفة الأصلي (YRMS_ORIGINALRECORD_YRMS_ID)']
  HousekeepingStatus_Id bigint [not null, note: 'رابط إلى جدول حالة الإشراف الداخلي (YRMS_YHKS_ID)']
  DefaultRackRateCode_Id bigint [note: 'كود معدل الـ Rack الافتراضي للغرفة (YRMS_DEFAULT_YRCH_ID)']
  DefaultRate decimal(30,4) [note: 'السعر الافتراضي الفعلي (YRMS_DEFAULT_RATE)']
  NoOfPersons int [not null, note: 'عدد الأشخاص المسموح به في الغرفة (YRMS_NOOFPERSONS)']
  Floor int [note: 'رقم الطابق (YRMS_FLOOR)']
  DefaultCredits int [note: 'رصيد التنظيف للإشراف الداخلي (YRMS_DEFAULTCREDITS)']
  DepartureCredits int [note: 'رصيد التنظيف عند المغادرة (YRMS_DEPARTURECREDITS)']
  HskOccupied int [note: 'حالة إشغال الإشراف الداخلي: 0=غير مشغول، 1=مشغول (YRMS_HSK_OCCUPIED)']
  MaxBeds int [note: 'الحد الأقصى للأسرة (YRMS_MAX_BEDS)']
  FreeText varchar(1000) [note: 'نص حر للغرفة (YRMS_FREETEXT)']
  Picture longblob [note: 'صورة الغرفة (YRMS_PICTURE)']
  LastStatusChangeDate date [note: 'تاريخ آخر تغيير لحالة الإشراف الداخلي (YRMS_L_STATUS)']
  HskNoOfPersons int [note: 'عدد الأشخاص المدخلين بواسطة عاملة النظافة (YRMS_HSK_NOOFPERSONS)']
  CleanCredits int [note: 'أرصدة الغرف النظيفة (YRMS_CLEANCREDITS)']
  SuitePrimaryRoom_Id bigint [note: 'رابط الغرفة الرئيسة للـ Suite (YRMS_SUITE_PRIMARY_YRMS_ID)']
  IsSuite int [not null, default: 0, note: 'مؤشر ما إذا كانت الغرفة جناحاً: 0=لا، 1=نعم (YRMS_SUITE)']
  GuestServiceStatus int [note: 'حالة خدمة النزلاء: 1=ترتيب الغرفة، 2=عدم الإزعاج، 3=إعادة ضبط (YRMS_GUESTSERVICE_STATUS)']
  IgnoreNaCheck int [note: 'تجاهل روتين التحقق من انتهاء الصلاحية لتدقيق الليلة (YRMS_IGNORE_NA_CHECK)']
  WalkOrder int [note: 'ترتيب المشي أو المسار للغرف (YRMS_WALKORDER)']
  MinNoOfPersons int [note: 'الحد الأدنى لعدد الأشخاص شاملاً الأطفال (YRMS_MINNOOFPERSONS)']
  BedRoomCategory_Id bigint [note: 'نوع السرير / رابط لأنواع الأسرّة (YRMS_BED_YCAT_ID)']
  HskFlag int [note: 'علامة الإشراف الداخلي: 0=افتراضي، 1=متسخة وشاغرة بعد المغادرة (YRMS_HSKFLAG)']
  CountYbed int [not null, default: 0, note: 'عداد سجلات الأسرة المرتبطة (YRMS_COUNT_YBED)']
  CountBed int [note: 'عداد الأسرة الكلي (YRMS_COUNTBED)']
}


// جدول ربط الحجوزات ببطاقات التسجيل (يسمى YRRC)
Table ReservationRegistrationCardLinks {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (YRRC_ID)']
  Reservation_Id bigint [note: 'رابط إلى جدول الحجوزات الرئيسي YRES (YRRC_YRES_ID)']
  FinancialProfile_Id bigint [note: 'رابط إلى جدول العملات أو الجداول المالية XMCS (YRRC_XCMS_ID)']
  RegCardNumber bigint [note: 'رقم بطاقة التسجيل المرتبطة (YRRC_REGCARDNUMBER)']
}

// جدول حالات الغرف (يسمى YRSC)
Table RoomStatuses {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (YRSC_ID)']
  ShortDesc varchar(3) [not null, note: 'الكود أو الوصف المختصر للحالة (YRSC_SHORTDESC)']
  LongDesc varchar(30) [not null, note: 'الوصف الطويل للحالة (YRSC_LONGDESC)']
  DisplayOrder int [note: 'ترتيب العرض (YRSC_DISPLORDER)']
  AffectAvailability int [note: 'يوضح ما إذا كانت هذه الحالة تخصم من الإتاحة أم لا: 1=خصم الغرفة من الإتاحة (YRSC_AFFECTAVAILABILITY)']
  RequireBackTime int [note: 'إذا اختار المستخدم هذه الحالة للغرفة، يجب أيضاً إدخال وقت عودتها (YRSC_REQUIREBACKTIME)']
  Color_Id bigint [note: 'مُعرف جدول الألوان أو التنسيق المرتبط (YRSC_WCOL_ID)']
  ReturnHousekeepingStatus_Id bigint [note: 'حالة الإشراف الداخلي عند العودة (YRSC_RETURN_YHKS_ID)']
  Role int [note: 'دور أو نوع الحالة: null=عادية OOO/OOS، 1=وصول مبكر، 2=مغادرة متأخرة (YRSC_ROLE)']
  DefaultReason_Id bigint [note: 'السبب الافتراضي (YRSC_DEFAULT_YRSR_ID)']
}

// جدول أسباب حالات الغرف (يسمى YRSR)
Table RoomStatusReasons {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (YRSR_ID)']
  ShortDesc varchar(3) [not null, note: 'الكود أو الوصف المختصر للسبب (YRSR_SHORTDESC)']
  LongDesc varchar(30) [not null, note: 'الوصف الطويل أو اسم السبب (YRSR_LONGDESC)']
  DisplayOrder int [note: 'ترتيب العرض (YRSR_DISPLORDER)']
}
// جدول ربط الأجنحة بالغرف (يسمى YRSS)
Table SuiteRoomLinks {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (YRSS_ID)']
  SuiteRoom_Id bigint [not null, note: 'مُعرف الغرفة أو الجناح الرئيسي المرتبط (YRSS_SUITE_YRMS_ID)']
  SubRoom_Id bigint [not null, note: 'مُعرف الغرفة الفرعية أو التابعة للجناح (YRSS_ROOM_YRMS_ID)']
}


// جدول سجل أو تاريخ حالات الغرف (يسمى YRST)
Table RoomStatusHistories {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (YRST_ID)']
  Room_Id bigint [not null, note: 'رابط إلى جدول الغرف الرئيسي YRMS (YRST_YRMS_ID)']
  FromTime timestamp [not null, note: 'تاريخ ووقت بداية الحالة (YRST_FROMTIME)']
  UntilTime timestamp [not null, note: 'تاريخ ووقت نهاية الحالة (YRST_UNTILTIME)']
  RoomStatus_Id bigint [not null, note: 'رابط إلى جدول حالات الغرف YRSC (YRST_YRSC_ID)']
  ReturnHousekeepingStatus_Id bigint [not null, note: 'رابط حالة الإشراف الداخلي عند العودة (YRST_RETURN_YHKS_ID)']
  RoomStatusReason_Id bigint [not null, note: 'رابط إلى جدول أسباب حالات الغرف YRSR (YRST_YRSR_ID)']
  Remark varchar(60) [note: 'حقل الملاحظات (YRST_REMARK)']
  IsBed int [not null, default: 0, note: 'مؤشر السرير (YRST_BED)']
  Reservation_Id bigint [note: 'رابط إلى جدول الحجوزات YRES (YRST_YRES_ID)']
  BedCount int [note: 'عداد الأسرة (YRST_BEDCOUNT)']
  BedDetail_Id bigint [note: 'رابط إلى جدول تفاصيل الأسرة (YRST_YBED_ID)']
}
// جدول معلومات أو تفاصيل الحجوزات العامة (يسمى YSGI)
Table GeneralReservationInformation {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (YSGI_ID)']
  Reservation_Id bigint [not null, note: 'رابط إلى جدول الحجوزات الرئيسي YRES (YSGI_YRES_ID)']
  TransactionOrSetting_Id bigint [note: 'معرف أو رابط خاص بقسم المعاملات أو الإعدادات التابعة (YSGI_XCMS_ID)']
  MarketPeriod_Id bigint [note: 'رابط إلى جدول فترات أو أسعار الأسواق YRPE (YSGI_YRPE_ID)']
}



// جدول تعليمات الفوترة (يسمى ZBIC)
Table BillingInstructions {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (ZBIC_ID)']
  ShortDesc varchar(3) [not null, note: 'الكود أو الوصف المختصر لتعليمات الفوترة (ZBIC_SHORTDESC)']
  LongDesc varchar(30) [not null, note: 'الوصف الطويل لتعليمات الفوترة (ZBIC_LONGDESC)']
  LangId bigint [note: 'عمود قديم أو ملغي (ZBIC_LANGID)']
  DisplayOrder int [note: 'ترتيب عرض تعليمات الفوترة (ZBIC_DISPLORDER)']
  IncludeAll int [note: 'تضمين جميع أكواد الأقسام: 0=لا، 1=نعم (ZBIC_ALL)']
  IsInactive int [note: 'مؤشر عدم التفعيل: 0=نشط، 1=غير نشط (ZBIC_INACTIVE)']
}


// جدول الصيارفة أو أرقام الخزن (يسمى ZCAS)
Table Cashiers {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (ZCAS_ID)']
  CashierNumber bigint [not null, note: 'رقم الخزنة أو الصراف (ZCAS_NUMBER)']
  LongDescription varchar(30) [not null, note: 'اسم الخزنة أو الصراف أو الوردية (ZCAS_LONGDESCRIPTION)']
  MaxOpenPerDay int [not null, note: 'الحد الأقصى لعدد مرات فتح الخزنة يومياً (ZCAS_MAXOPENPERDAY)']
  IsOpen int [not null, note: 'حالة الخزنة: 1=مفتوحة، 2=مغلقة (ZCAS_OPEN)']
  OnlyAllowExcOpen int [not null, note: 'الفتح الحصري لمستخدم واحد في نفس الوقت: 0=لا، 1=نعم (ZCAS_ONLYALLOWEXCOPEN)']
  IsIfc int [note: 'مؤشر الواجهة الخارجية المخصصة للواجهات فقط: 0=لا، 1=نعم (ZCAS_IFC)']
  StockReset int [note: 'إعادة تعيين المخزون للقيمة الافتراضية مع كل فتح: 0=لا، 1=نعم (ZCAS_STOCKRESET)']
  IsInactive int [default: 0, note: 'مؤشر عدم التفعيل: 0=نشط، 1=غير نشط (ZCAS_INACTIVE)']
}




// جدول أكواد الأقسام أو مراكز التكلفة والخدمات (يسمى ZDCO)
Table DepartmentCodes {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (ZDCO_ID)']
  ShortDesc varchar(3) [note: 'الوصف أو الكود المختصر للقسم (ZDCO_SHORTDESC)']
  LongDesc varchar(30) [not null, note: 'الوصف الطويل أو اسم القسم (ZDCO_LONGDESC)']
  NumericDesc bigint [not null, note: 'كود القسم الرقمي (ZDCO_NUMERICDESC)']
  DisplayOrder int [note: 'ترتيب عرض القسم (ZDCO_DISPLORDER)']
  CdtType int [not null, note: 'نوع القسم: 1=مدين، 2=ضريبة، 5=دائن (ZDCO_CDT)']
  ManualPost int [note: 'السماح بالترحيل اليدوي للأقسام المدينة فقط: 0=لا، 1=نعم (ZDCO_MANUALPOST)']
  ScreenArrangement_Id bigint [note: 'معرف شاشة تعديل كود القسم ZARR (ZDCO_ZARR_ID)']
  UnitDescription varchar(10) [note: 'وصف الوحدات مثل pcs أو kg (ZDCO_UNITDESCRIPTION)']
  GovCode varchar(30) [note: 'الكود الحكومي للقسم (ZDCO_GOVCODE)']
  CityLedgerOld int [note: 'قديم، يتم التعرف على الـ City Ledger حالياً بواسطة ZDCO_PAYM_TYPE (ZDCO_CITYLEDGER)']
  InterfaceGroup_Id bigint [note: 'معرف مجموعة أكواد الأقسام ZDCG (ZDCO_ZDCG_ID)']
  PaymentType int [note: 'نوع الدفع: 0=نقدي، 1=شيك، 2=حساب مدين، 3=بطاقة اتمان، 4=عملة أجنبية، 5=متفرقات (ZDCO_PAYM_TYPE)']
  PaidOut int [note: 'تخصيص أقسام الصرف النقدي Paid Out: 0=لا، 1=نعم (ZDCO_PAIDOUT)']
  DisabledPreArrival int [note: 'تعطيل الاستخدام في مرحلة الحجز المسبق (ZDCO_DISABLED_PREARR)']
  DisabledBilling int [note: 'تعطيل الاستخدام في شاشة الفواتير (ZDCO_DISABLED_BILLING)']
  DisabledAR int [note: 'تعطيل الاستخدام في نظام الحسابات المدينة (ZDCO_DISABLED_AR)']
  NonHotelRevenue int [note: 'مؤشر الإيرادات غير الفندقية (ZDCO_NONHTLREV)']
  StatsType int [note: 'نوع الإحصائيات: 1=إقامة، 2=أغذية ومشروبات، 3=ميني بار، 4=هاتف، 5=متفرقات (ZDCO_STATS_TYPE)']
  BofCreditAccount bigint [note: 'حساب الدائن للـ Back Office (ZDCO_BOF_CR_ACC)']
  BofDebitAccount bigint [note: 'حساب المدين للـ Back Office (ZDCO_BOF_DB_ACC)']
  BofDepartment bigint [note: 'قسم الـ Back Office (ZDCO_BOF_DEP)']
  FolioText varchar(30) [note: 'وصف مخصص لفواتير النزلاء (ZDCO_FOLIOTEXT)']
  DisabledCcm int [note: 'مؤشر عدم التوفر لـ CCM (ZDCO_DISABLED_CCM)']
  BofUdefNum1 bigint [note: 'حقل رقمي مخصص للـ Back Office (ZDCO_BOF_UDEF_NUM_1)']
  BofUdefChar1 varchar(50) [note: 'حقل نصي مخصص للـ Back Office (ZDCO_BOF_UDEF_CHAR_1)']
  UdefNum1 bigint [note: 'حقل إضافي عام (ZDCO_UDEF_NUM_1)']
  UdefAmnt2 decimal(30,4) [note: 'حقل مالي إضافي عام (ZDCO_UDEF_AMNT_2)']
}
// جدول مجموعات الواجهات أو الإعدادات المرتبطة (يسمى ZDCG)
Table InterfaceGroups {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (ZDCG_ID)']
  ShortDesc varchar(3) [not null, note: 'الكود أو الوصف المختصر (ZDCG_SHORTDESC)']
  LongDesc varchar(30) [not null, note: 'الوصف الطويل أو الاسم التفصيلي (ZDCG_LONGDESC)']
  DisplayOrder int [note: 'ترتيب العرض (ZDCG_DISPLORDER)']
  DepartmentGroup_Id bigint [note: 'رابط مع جدول مجموعات الأقسام ZDMG (ZDCG_ZDMG_ID)']
  IsInactive int [note: 'مؤشر عدم التفعيل: 0=نشط، 1=غير نشط (ZDCG_INACTIVE)']
  IsCentral int [default: 0, not null, note: 'مؤشر الإعداد المركزي: 0=لا، 1=نعم (ZDCG_CENTRAL)']
}
// جدول إعدادات وتفاصيل الضرائب المرتبطة بالأقسام والتواريخ (يسمى ZDTL)
Table DepartmentTaxesLink {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (ZDTL_ID)']
  DepartmentCode_Id bigint [not null, note: 'رابط مع جدول أكواد الأقسام ZDCO (ZDTL_ZDCO_ID)']
  TaxCode_Id bigint [not null, note: 'رابط مع جدول رموز أو فئات الضرائب (ZDTL_ZTXC_ID)']
  FromTime timestamp [not null, note: 'تاريخ وساعة بداية تطبيق الضريبة (ZDTL_FROMTIME)']
  ToTime timestamp [note: 'تاريخ وساعة نهاية تطبيق الضريبة (ZDTL_TOTIME)']
  TaxPreArrival varchar(1) [note: 'مؤشر تطبيق الضريبة على الحجز المسبق فقط (ZDTL_TAX_PREARR)']
  TaxExemption_Id bigint [note: 'رابط مع إعفاءات الضرائب (ZDTL_ZTXX_ID)']
  IgnoreNaCheck int [note: 'تجاهل الفحص من روتين انتهاء التدقيق الليلي: 0=لا، 1=نعم (ZDTL_IGNORE_NA_CHECK)']
  CalcRule int [note: 'قاعدة حساب ضريبة الفنادق الفاخرة الهندية (ZDTL_CALCRULE)']
  ApplicableRule int [note: 'القاعدة المطبقة لضريبة الفنادق الفاخرة الهندية (ZDTL_APPLICABLERULE)']
  OnPhysicalRoom int [note: 'مؤشر الحساب على الغرفة الفعلية: 0=لا، 1=نعم (ZDTL_ON_PHYSICAL_ROOM)']
}

// جدول سجلات الطابعة المالية أو ربط الفوترة الإلكترونية (يسمى ZFCF)
Table FiscalPrinterTransactions {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (ZFCF_ID)']
  Invoice_Id bigint [not null, note: 'رابط مع جدول الفواتير ZINV (ZFCF_ZINV_ID)']
  GenerationDate timestamp [note: 'تاريخ وتوقيت إنشاء السجل أو المعاملة المالية (ZFCF_GENERATION_DATE)']
  ResponseXml xml [note: 'ملف الاستجابة بصيغة XML (ZFCF_RESPONSE_XML)']
  Status varchar(30) [note: 'حالة المعاملة المالية أو الطابعة (ZFCF_STATUS)']
  PayeeExternalSystem_Id bigint [note: 'مرجع معرف جهة الدفع بنظام خارجي (ZFCF_PAYEE_XCMS_ID)']
  FiscalResource_Id bigint [note: 'مرجع معرف الموارد المالية الضريبية (ZFCF_FISCAL_YRES_ID)']
  Signature varchar(400) [note: 'التوقيع الإلكتروني المستخرج من الطابعة الضريبية (ZFCF_SIGNATURE)']
  RunningTotal decimal(30,4) [note: 'الإجمالي الجاري المقدم من الطابعة الضريبية (ZFCF_RUNNING_TOTAL)']
  Workstation_Id bigint [note: 'رابط مع معرف محطة العمل WPCA (ZFCF_WPCA_ID)']
  ReceiptNumber varchar(30) [note: 'رقم الإيصال المستلم من الطابعة الضريبية (ZFCF_RECEIPT_NUMBER)']
  DepJson clob [note: 'بيانات الـ DEP المستلمة بصيغة JSON (ZFCF_DEP)']
  CashRegisterId varchar(16) [note: 'معرف خزينة النقود أو نقطة البيع (ZFCF_CASH_REGISTER_ID)']
  TransactionType varchar(1) [note: 'نوع المعاملة: I=أولية، N=فاتورة، Z=صفرية (ZFCF_TRANSACTION_TYPE)']
  DepTimestamp timestamp [note: 'الطابع الزمني المرسل ضمن الاستجابة (ZFCF_DEP_TIMESTAMP)']
}

// جدول الفواتير الرئيسي (يسمى ZINV)
Table Invoices {
  Id bigint [pk, note: 'المُعرف الفريد للفاتورة (ZINV_ID)']
  InvoiceDate timestamp [not null, note: 'تاريخ إنشاء وإصدار الفاتورة (ZINV_DATE)']
  InvoiceNumber varchar(60) [not null, note: 'رقم الفاتورة الرسمي (ZINV_NUMBER)']
  InvoiceCounter_Id bigint [not null, note: 'مرجع مرتبط بجدول ZINN (ZINV_ZINN_ID)']
  ExternalSystem_Id bigint [note: 'مرجع النظام أو المعرف الخارجي (ZINV_XCMS_ID)']
  InvoiceStatus_Id bigint [note: 'مرجع مرتبط بحالة الفاتورة ZFST (ZINV_ZFST_ID)']
  CityLedger int [note: 'مؤشر السداد الآجل: 0=مدفوع، 1=غير مدفوع (ZINV_CITYLEDGER)']
  Window_Id bigint [note: 'مرجع مرتبط بمعرف نافذة أو حجز ZWIN (ZINV_ZWIN_ID)']
  ExternalAddress_Id bigint [note: 'مرجع العنوان الخارجي XADR (ZINV_XADR_ID)']
  ContactExternalSystem_Id bigint [note: 'مرجع جهة الاتصال الخارجية (ZINV_CONTACT_XCMS_ID)']
  Printed int [note: 'حالة طباعة الفاتورة: 0=لم تطبع، 1=طبعت، 2=فشل الطبع (ZINV_PRINTED)']
  PcDate timestamp [note: 'التاريخ والوقت الدقيق لتوليد الفاتورة (ZINV_PCDATE)']
  Role int [note: 'دور الفاتورة: 0=عادية، 1=دفعة مقدمة، 2=سداد آجل (ZINV_ROLE)']
  VoidInvoice_Id bigint [note: 'معرف الفاتورة الأصلية الملغاة (ZINV_VOID_ZINV_ID)']
  FiscalNumber varchar(100) [note: 'الرقم الضريبي المسترد من الطابعة المالية (ZINV_FISCALNUMBER)']
  CorrectingInvoice_Id bigint [note: 'معرف فاتورة التصحيح المرتبطة (ZINV_CORRECTING_ZINV_ID)']
  CityLedgerNumber varchar(60) [note: 'رقم حساب الـ City Ledger (ZINV_CITYLEDGERNUMBER)']
  ManualNumber varchar(60) [note: 'رقم الفاتورة اليدوي (ZINV_MANUALNUMBER)']
  FiscalInvoice int [default: 0, not null, note: 'مؤشر الفوترة الإلكترونية التركية (ZINV_FISCALINVOICE)']
  InvoiceNumber2 varchar(60) [note: 'رقم فاتورة ثانوي للأرشيف الإلكتروني (ZINV_NUMBER2)']
  Email varchar(100) [note: 'البريد الإلكتروني لإرسال الفواتير إلكترونياً (ZINV_EMAIL)']
}
// جدول ربط العملات الأجنبية بالأسعار والأقسام (يسمى ZIXC)
Table DepartmentCurrencyConfig {
  Id bigint [pk, note: 'المُعرف الفريد للسجل (ZIXC_ID)']
  DepartmentCode_Id bigint [not null, note: 'رابط مع كود القسم أو الإدارة ZDCO (ZIXC_ZDCO_ID)']
  Currency_Id bigint [not null, note: 'رابط مع جدول العملات ZCUR (ZIXC_ZCUR_ID)']
  RateType int [note: 'نوع سعر الصرف: 0=سعر عادل، 1=سعر نقدي، 2=سعر كود السعر (ZIXC_RATE_TYPE)']
}

// جدول تعريفات أو أرصدة البداية للصرافين (يسمى ZMUC)
Table CashierStartingAmounts {
  Id bigint [pk, note: 'المُعرف الفريد لسجل تعريف الصراف (ZMUC_ID)']
  Cashier_Id bigint [not null, note: 'رابط مع جدول تعريف الصرافين ZCAS (ZMUC_ZCAS_ID)']
  DepartmentCode_Id bigint [not null, note: 'رابط مع كود القسم، نقدي أو عملة أجنبية ZDCO (ZMUC_ZDCO_ID)']
  StartingAmount decimal(30,4) [not null, note: 'مبلغ البداية ويجب أن يكون أكبر من أو يساوي صفر (ZMUC_STARTINGAMOUNT)']
}

// جدول ربط القيود المالية بالكيانات أو الأدوار المختلفة (يسمى ZORG)
Table PostingOrigin {
  Id bigint [pk, note: 'المُعرف الفريد للسجل (ZORG_ID)']
  Posting_Id bigint [not null, note: 'رابط مع سجل الحركة المالية الأساسية ZPOS (ZORG_ZPOS_ID)']
  Role int [note: 'يحدد دور أو نوع القيد: 1=Rate Code، 2=Article، 3=Package، 4=Department Code (ZORG_ROLE)']
  Table_Id bigint [note: 'مُعرف الجدول أو الكيان المرتبط بناءً على الدور (ZORG_TABLE_ID)']
}

// جدول اسم منشئ القيد المخصص أو اسم الضيف (يسمى ZPCF)
Table CustomPostingOriginator {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (ZPCF_ID)']
  Posting_Id bigint [not null, note: 'رابط مع سجل الحركة المالية ZPOS (ZPCF_ZPOS_ID)']
  CustomOriginatorName varchar(121) [note: 'اسم الضيف المنشئ للحركة أو القيد (ZPCF_CUSTOMORIGINATORNAME)']
}

// جدول ربط الفواتير بالحركات المالية أو عناصر الفاتورة (يسمى ZPIL)
Table PostingInvoiceLink {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الربط (ZPIL_ID)']
  Invoice_Id bigint [not null, note: 'مرجع معرف الفاتورة المرتبطة ZINV (ZPIL_ZINV_ID)']
  Posting_Id bigint [not null, note: 'مرجع معرف الحركة المالية أو القيد المرتبط ZPOS (ZPIL_ZPOS_ID)']
}
// جدول الحركات المالية والقيود الرئيسي (يسمى ZPOS)
Table FinancialPostings {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الحركة (ZPOS_ID)']
  Customer_Id bigint [not null, note: 'رابط مع حساب العميل أو الضيف (ZPOS_XCMS_ID)']
  Reservation_Id bigint [note: 'رابط مع الحجز (ZPOS_YRES_ID)']
  Account_Id bigint [note: 'مرجع مرتبط بجدول الفواتير أو الحسابات ZFAC (ZPOS_ZFAC_ID)']
  DepartmentCode_Id bigint [not null, note: 'رابط مع كود القسم أو الإدارة ZDCO (ZPOS_ZDCO_ID)']
  DepartmentCode2_Id bigint [note: 'مرجع ثانٍ مرتبط بالأقسام ZDC2 (ZPOS_ZDC2_ID)']
  UnitPrice decimal(30,4) [not null, note: 'سعر الوحدة، ويضرب في الكمية (ZPOS_UNITPRICE)']
  Quantity int [not null, note: 'الكمية (ZPOS_QUANTITY)']
  Description varchar(30) [not null, note: 'الوصف أو اسم القيد (ZPOS_DESCRIPT)']
  PostDate timestamp [not null, note: 'تاريخ القيد أو الحركة المالية (ZPOS_POSTDATE)']
  PcDate timestamp [not null, note: 'تاريخ ووقت جهاز الكمبيوتر (ZPOS_PCDATE)']
  ThirdPartyDate timestamp [note: 'تاريخ الطرف الثالث (ZPOS_THIRDPARTYDATE)']
  Currency_Id bigint [note: 'رابط مع جدول العملات ZCUR (ZPOS_ZCUR_ID)']
  ExchangeRate decimal(30,4) [note: 'قيمة سعر الصرف (ZPOS_EXCHANGERATE)']
  ForeignPrice decimal(30,4) [note: 'المبلغ بالعملة الأجنبية (ZPOS_FOREIGNPRICE)']
  Cashier_Id bigint [not null, note: 'رقم الصراف أو الموظف (ZPOS_ZCAS_ID)']
  User_Id bigint [note: 'معرف المستخدم الذي أدخل الحركة (ZPOS_USER_XCMS_ID)']
  OriginatedCustomer_Id bigint [note: 'معرف العميل المصدر الأساسي (ZPOS_ORIGINATED_XCMS_ID)']
  OriginatedReservation_Id bigint [note: 'معرف الحجز المصدر للقيد (ZPOS_ORIGINATED_YRES_ID)']
  OriginatedAccount_Id bigint [note: 'معرف الفاتورة المصدر للقيد (ZPOS_ORIGINATED_ZFAC_ID)']
  ReferenceArrangement_Id bigint [note: 'مرجع مرتبطة بجدول ZARR (ZPOS_ZARR_ID)']
  CommentText varchar(60) [note: 'تعليق أو ملاحظة على الحركة (ZPOS_COMMENT)']
  Article_Id bigint [note: 'رابط مع جدول الأصناف ZART (ZPOS_ZART_ID)']
  Covers int [note: 'عدد الأفراد أو الضيوف في المطعم (ZPOS_COVERS)']
  TaxLink_Id bigint [not null, note: 'رابط الضرائب بين السجلات المرتبطة (ZPOS_TAXLINK_ID)']
  SumUpId bigint [note: 'معرف تجميع القيود الأسبوعية أو الشهرية (ZPOS_SUMUPID)']
  InternalSplitPosting_Id bigint [note: 'معرف القيد الرئيسي في التقسيم الداخلي (ZPOS_INTERNALSPLIT_ZPOS_ID)']
  CreditDebitType int [not null, note: 'نوع القيد: 1=مدين، 2=ضريبة، 5=دفع/دائن (ZPOS_CDT)']
  PhoneNumber varchar(30) [note: 'رقم الهاتف المطلوب (ZPOS_PHONENR)']
  ManualSplit_Id bigint [note: 'معرف التقسيم اليدوي (ZPOS_MANUALSPLIT_ID)']
  PaidOut int [not null, note: 'مؤشر الصرف النقدي: 1=true (ZPOS_PAIDOUT)']
  Window_Id bigint [not null, note: 'معرف النافذة الحسابية المرتبطة ZWIN (ZPOS_ZWIN_ID)']
}
// جدول إدارة بطاقات الخصم والعروض الليالي المجانية (يسمى ZRCC)
Table RoomResourceCardConfig {
  Id bigint [pk, note: 'المُعرف الفريد ويطابق XMTY_ID (ZRCC_ID)']
  FreeNights int [not null, note: 'عدد الليالي المجانية الممنوحة (ZRCC_FREENIGHTS)']
  FreeAdults int [note: 'أقصى عدد من البالغين للإقامة المجانية (ZRCC_FREEADULTS)']
  Price decimal(30,4) [note: 'السعر، وإذا كان فارغاً يُأخذ من ZFAG (ZRCC_PRICE)']
  PriceDepartmentCode_Id bigint [note: 'معرف كود القسم الخاص بالسعر ZDCO (ZRCC_PRICE_ZDCO_ID)']
  LengthOfValidity int [not null, note: 'مدة صلاحية البطاقة أو العرض (ZRCC_LENGTHOFVALIDITY)']
  ValidityType int [not null, note: 'نوع وحدة الصلاحية: 0=سنوات، 1=شهور، 2=أسابيع، 3=أيام (ZRCC_VALIDITYTYPE)']
  PriceGroup_Id bigint [not null, note: 'معرف مجموعة الأسعار أو العروض ZFAG (ZRCC_ZFAG_ID)']
  Transferable int [not null, note: 'قابلية التحويل لشخص آخر: 0=لا، 1=نعم (ZRCC_TRANSFERABLE)']
  AccountCloseRhythm int [not null, note: 'إيقاع إغلاق الحساب: 0=لا شيء، 1=نهاية الشهر التقويمي، 2=طول الشهر (ZRCC_ACCOUNTCLOSERHYTHM)']
  AccountCloseNumber int [not null, note: 'رقم إغلاق الحساب (ZRCC_ACCOUNTCLOSENUMBER)']
  PaymentDepartmentCode_Id bigint [note: 'معرف كود قسم الدفع المرتبط ZDCO (ZRCC_PAYMENT_ZDCO_ID)']
  CreditLimitRule_Id bigint [note: 'معرف جدول قواعد الائتمان ZCRL (ZRCC_ZCRL_ID)']
  CreditLimit decimal(30,4) [note: 'حد الائتمان المسموح (ZRCC_CREDITLIMIT)']
  ExpiryAtEndOfCalendarUnit int [note: 'مؤشر انتهاء الصلاحية بنهاية وحدة التقويم (ZRCC_EXPIRYATENDOFCALENDARUNIT)']
}
// جدول تكوين بطاقات الخصم والتخفيضات (يسمى ZRCR)
Table RebateCardConfig {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الجدول (ZRCR_ID)']
  CardType_Id bigint [note: 'مرجع مرتبط بمعرف نوع البطاقة أو الحركة XMTY (ZRCR_XMTY_ID)']
  DepartmentCode_Id bigint [not null, note: 'مرجع مرتبط بكود القسم ZDCO (ZRCR_ZDCO_ID)']
  Rebate decimal(7,4) [not null, note: 'نسبة التخفيض المئوية (ZRCR_REBATE)']
  RebateTogether decimal(7,4) [not null, note: 'نسبة التخفيض في حال امتلاك بطاقات تخفيض أخرى (ZRCR_REBATETOGETHER)']
  MaxNoOfRebate int [not null, note: 'أقصى عدد مرات لتطبيق التخفيض، 0=غير محدود (ZRCR_MAXNOOFREBATE)']
  RebateDepartmentCode_Id bigint [not null, note: 'مكان ترحيل قيود التخفيض ZDCO (ZRCR_REBATE_ZDCO_ID)']
  RebateDef_Id bigint [note: 'مرجع مرتبط بجدول ZRDF (ZRCR_ZRDF_ID)']
  FlatAmount decimal(30,4) [note: 'مبلغ تخفيض ثابت (ZRCR_FLATAMOUNT)']
}
// جدول تعريفات الخصومات أو التخفيضات والفترات (يسمى ZRDF)
Table RebateDefinitions {
  Id bigint [pk, note: 'المُعرف الفريد لسجل التعريف (ZRDF_ID)']
  ShortDesc varchar(10) [not null, note: 'الوصف القصير لتعريف الخصم (ZRDF_SHORTDESC)']
  LongDesc varchar(30) [not null, note: 'الوصف الطويل لتعريف الخصم (ZRDF_LONGDESC)']
  Inactive int [not null, note: 'مؤشر إلغاء التفعيل (ZRDF_INACTIVE)']
  DisplayOrder int [not null, note: 'ترتيب العرض في القوائم (ZRDF_DISPLORDER)']
  FromTime timestamp [note: 'وقت بداية الصلاحية (ZRDF_FROMTIME)']
  UntilTime timestamp [note: 'وقت نهاية الصلاحية (ZRDF_UNTILTIME)']
  Color_Id bigint [note: 'مرجع مرتبط بمعرف الألوان أو التصنيف WCOL (ZRDF_WCOL_ID)']
  Barcode varchar(30) [note: 'النص المرتبط بالباركود (ZRDF_BARCODE)']
  ValidForBooking int [note: 'مؤشر الصلاحية للحجوزات (ZRDF_BOOKING)']
  ValidForReservation int [note: 'مؤشر الصلاحية لحجوزات الغرف (ZRDF_RESERVATION)']
}

// جدول تكوين وربط الضرائب (يسمى ZTCD)
Table TaxesConfig {
  Id bigint [pk, note: 'المُعرف الفريد لسجل تكوين الضريبة (ZTCD_ID)']
  TaxDescription_Id bigint [not null, note: 'رابط مع جدول وصف الضرائب ZTXC (ZTCD_ZTXC_ID)']
  PostToDepartmentCode_Id bigint [not null, note: 'رابط مع كود القسم المالي لترحيل الضرائب ZDCO (ZTCD_POSTTO_ZDCO_ID)']
  Udf varchar(200) [not null, note: 'حقل محدد بواسطة المستخدم (ZTCD_UDF)']
  CalculationOrder int [not null, note: 'ترتيب حساب الضريبة (ZTCD_ORDER)']
  ValidFrom timestamp [not null, note: 'تاريخ بداية الصلاحية (ZTCD_VALIDFROM)']
  ValidUntil timestamp [not null, note: 'تاريخ نهاية الصلاحية (ZTCD_VALIDUNTIL)']
  Include int [note: 'مؤشر التضمين أو الشمول (ZTCD_INCLUDE)']
  TaxName varchar(30) [note: 'اسم الضريبة (ZTCD_NAME)']
  PrintSeparate int [note: 'عرض الضريبة بشكل منفصل على شاشة الفوترة والفاتورة: 1=نعم (ZTCD_PRINTSEPARATE)']
  PostZero int [note: 'ترحيل القيد حتى لو كانت القيمة صفر: 1=نعم (ZTCD_POSTZERO)']
  IgnoreNaCheck int [note: 'تجاهل فحص التدقيق الليلي: 1=نعم (ZTCD_IGNORE_NA_CHECK)']
  InDiaLuxuryTax int [note: 'مؤشر ضريبة الكماليات الهندية: 1=نعم (ZTCD_INDIALUXURYTAX)']
}
// جدول أنواع أو أوصاف الضرائب (يسمى ZTXC)
Table TaxDescriptions {
  Id bigint [pk, note: 'المُعرف الفريد لسجل وصف الضريبة (ZTXC_ID)']
  ShortDesc varchar(3) [not null, note: 'الوصف القصير للضريبة (ZTXC_SHORTDESC)']
  LongDesc varchar(60) [not null, note: 'الوصف الطويل أو اسم الضريبة (ZTXC_LONGDESC)']
  DisplayOrder int [note: 'ترتيب العرض (ZTXC_DISPLORDER)']
  BofVatCode varchar(1) [note: 'كود ضريبة القيمة المضافة لأنظمة الخلفية (ZTXC_BOF_VATCODE)']
  SftxOrder int [note: 'رقم يحدد عمود ظهور الضريبة في تقارير SFTX (ZTXC_SFTX_ORDER)']
  CityTax int [note: 'مؤشر ضريبة المدينة: 1=لا تحسب ضمن الإجماليات (ZTXC_CITYTAX)']
  BofDefaultDeposit int [note: 'كود الضريبة الافتراضي للإيداع في الخلفية (ZTXC_BOF_DEFAULT_DEPOSIT)']
  TaxExemption int [note: 'مؤشر دعم الإعفاء الضريبي الإيطالي (ZTXC_TAX_EXEMPTION)']
  TaxBucketCode varchar(2) [note: 'كود تجميع الضرائب للسلع والخدمات الهندية (ZTXC_TAX_BUCKET_CODE)']
}


// جدول نوافذ الفوترة الخاصة بالحجوزات (يسمى ZWIN)
Table BillingWindows {
  Id bigint [pk, note: 'المُعرف الفريد لسجل نافذة الفوترة (ZWIN_ID)']
  WindowNumber int [not null, note: 'رقم نافذة الفوترة (ZWIN_WINDOW)']
  Reservation_Id bigint [note: 'معرف الحجز المرتبط YRES (ZWIN_YRES_ID)']
  Account_Id bigint [note: 'معرف الحساب المالي ZFAC (ZWIN_ZFAC_ID)']
  InvoiceToProfile_Id bigint [note: 'الملف الشخصي الموجه إليه الفاتورة (ZWIN_INVOICE_TO_XCMS_ID)']
  InvoiceToAddress_Id bigint [note: 'العنوان المحدد من عناوين الملف الشخصي XADR (ZWIN_INVOICE_TO_XADR_ID)']
  InvoiceToContact_Id bigint [note: 'جهة الاتصال المحددة للملف الشخصي (ZWIN_INVOICE_TO_CONTACT_ID)']
  BillView int [note: 'السماح بعرض الفاتورة على النافذة: القيمة الافتراضية 1 (ZWIN_BILLVIEW)']
  VideoCheckOut int [note: 'السماح بالمغادرة عبر الفيديو: القيمة الافتراضية 1 (ZWIN_VIDEO_CO)']
  FreeText1 varchar(60) [note: 'نص حر للطباعة على الفوليو (ZWIN_FREETEXT1)']
  FreeText2 varchar(60) [note: 'نص حر إضافي للطباعة على الفوليو (ZWIN_FREETEXT2)']
  PaymentDepartmentCode_Id bigint [note: 'طريقة الدفع للنافذة، تتجاوز الافتراضي ZDCO (ZWIN_PAYMENT_ZDCO_ID)']
  Rule_Id bigint [note: 'معرف جدول قواعد الحجز المرتبط YRCL (ZWIN_YRCL_ID)']
  FreeText3 varchar(60) [note: 'نص حر ثالث لكل نافذة فوترة (ZWIN_FREETEXT3)']
  FreeText4 varchar(60) [note: 'نص حر رابع لكل نافذة فوترة (ZWIN_FREETEXT4)']
  FolioStyle_Id bigint [note: 'رابط لتكوين نمط الفوليو ZFST (ZWIN_ZFST_ID)']
  WindowType_Id bigint [not null, note: 'رابط لأنواع نوافذ الفوترة ZWIT (ZWIN_ZWIT_ID)']
  BalanceBeforeClose decimal(30,4) [note: 'الرصيد عند المغادرة قبل التسوية (ZWIN_BALANCEBEFORECLOSE)']
  NoBonusPoints int [not null, note: 'مؤشر منع نقاط المكافآت: 0=لا، 1=نعم (ZWIN_NOBONUSPOINTS)']
  RebateDef_Id bigint [note: 'كود التخفيض المرتبط بالنافذة ZRDF (ZWIN_ZRDF_ID)']
}
// جدول أنواع نوافذ الفوترة (يسمى ZWIT)
Table BillingWindowTypes {
  Id bigint [pk, note: 'المُعرف الفريد لسجل نوع نافذة الفوترة (ZWIT_ID)']
  WindowType int [not null, note: 'نوع النافذة: 0=عادي، 1=خصم شخصي، 2=وجبة شخصية، 3=غير قابل للخصم (ZWIT_TYPE)']
  ShortDesc varchar(5) [not null, note: 'الوصف القصير لنوع النافذة (ZWIT_SHORTDESC)']
  LongDesc varchar(30) [not null, note: 'الوصف الطويل أو اسم النوع (ZWIT_LONGDESC)']
  Color_Id bigint [note: 'معرف اللون المخصص لهذا النوع WCOL (ZWIT_WCOL_ID)']
}


