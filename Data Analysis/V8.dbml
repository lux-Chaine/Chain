  GrossRoomRevenue decimal(30,4) [note: 'إجمالي إيرادات الغرف (XCTH_GROSSROOMREV)']
  NoOfAttendees bigint [note: 'عدد الحضور أو المشاركين (XCTH_NOOFATTENDEES)']
  NoOfEvents bigint [note: 'عدد الفعاليات (XCTH_NOOFEVENTS)']
  CcmGrossRevenue decimal(30,4) [note: 'إجمالي إيرادات CCM (XCTH_CCMGROSSREV)']
  MasterContract_Id bigint [note: 'معرف العقد الرئيسي في حال وجود عقود تابعة (XCTH_MASTER_XCTH_ID)']
  Wphs_Id bigint [note: 'معرف الربط بجدول أو نظام WPHS (XCTH_WPHS_ID)']
  ExpiryDate timestamp [note: 'تاريخ انتهاء الصلاحية أو العقد (XCTH_EXPIRYDATE)']
  SignUpDate timestamp [note: 'تاريخ توقيع العقد (XCTH_SIGNUPDATE)']
  StartDate timestamp [note: 'تاريخ بدء العقد أو الفعالية (XCTH_STARTDATE)']
  ContractName varchar(30) [note: 'اسم العقد النصي (XCTH_CONTRACTNAME)']
}
// جدول ربط العقود وإحصائيات الشركات بالعملاء (كان يسمى XCTL)
Table CorporateContractCustomerLinks {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XCTL_ID)']
