// جدول حسابات الذمم والقبض (كان يسمى AACC)
Table Accounts {
  Id bigint [pk, note: 'المُعرف الفريد الرئيسي للحساب (AACC_ID)']
  Type_Id bigint [note: 'رابط نوع الحساب (Account Type Link)']
  Profile_Id bigint [note: 'مُعرف الملف الشخصي أو العميل (AACC_XCMS_ID)']
  Number varchar(20) [note: 'رقم الحساب التجاري أو الظاهري للعميل (AR Number)']
  CreditLimit decimal(30,4) [note: 'الحد الائتماني المسموح به للحساب']
  Batch int [note: 'مؤشر منطقي لنظام الدفعات أو العمل الجماعي']
  Permanent int [note: 'حساب دائم أم مؤقت']
  Obsolete int [note: 'علم الإلغاء أو التوقف']
  Address_Id bigint [note: 'مُعرف العنوان (Address ID)']
  ContactProfile_Id bigint [note: 'مُعرف جهة الاتصال المسؤولة مالياً']
  PaymentsAccount_Id bigint [note: 'مرجع سجل ربط عمليات الدفع']
  MinDaysBetweenReminders int [note: 'الحد الأدنى للأيام بين خطابات التذكير']
  CreditSum decimal(30,4) [note: 'إجمالي الائتمان أو رصيد المعاملات']
  CreditFlag int [default: 0, note: 'علم الائتمان وسياساته']
  SiteNumber varchar(20) [note: 'رقم الموقع أو الفرع']
}

// جدول أنواع حسابات القبض (كان يسمى ATYP)
Table AccountTypes {
  Id bigint [pk, note: 'المُعرف الفريد لنوع حساب القبض (ATYP_ID)']
  ShortDescription varchar(3) [note: 'الوصف المختصر أو الكود المختصر لنوع الحساب']
  LongDescription varchar(30) [note: 'الوصف التفصيلي أو الاسم الكامل لنوع الحساب']
  DisplayOrder int [note: 'ترتيب العرض أو التسلسل لأنواع الحسابات']
  MinDaysBetweenReminders int [note: 'الحد الأدنى للأيام بين خطابات التذكير المخصصة']
}

// جدول عناوين العملاء (كان يسمى XADR)
Table CustomerAddresses {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد للعنوان (XADR_ID)']
  AddressType_Id bigint [note: 'رابط إلى أنواع العناوين']
  IsPrimary int [note: 'العنوان الرئيسي (1) أم لا (0)']
  ZipCode varchar(15) [note: 'الرمز البريدي']
  Street1 varchar(60) [note: 'سطر العنوان الأول']
  Street2 varchar(60) [note: 'سطر العنوان الثاني']
  Street3 varchar(60) [note: 'سطر العنوان الثالث']
  City varchar(60) [note: 'المدينة']
  Country_Id bigint [note: 'رابط إلى جدول الدول']
  Customer_Id bigint [note: 'رابط إلى جدول العملاء']
  State_Id bigint [note: 'رابط إلى جدول الولايات/المقاطعات']
  Global_Id bigint [note: 'مُعرف العنوان الرئيسي في الفنادق الشريكة']
  IsVerified int [note: 'مؤشر التحقق من العنوان']
  WebTown_Id bigint [note: 'رابط إلى مدن الويب']
  FidcRs_Id varchar(20) [note: 'مُعرف الحجز أو النظام المركزي']
}

// جدول العملاء الأساسي والملفات الشخصية (كان يسمى XCMS)
Table Customers {
  Id bigint [pk, note: 'مُعرف العميل الفريد (XCMS_ID)']
  Name1 varchar(35) [note: 'اسم العاهل أو الاسم الرئيسي الأول']
  Name2 varchar(35) [note: 'الاسم الثاني للعميل']
  Name3 varchar(35) [note: 'الاسم الثالث للعميل']
  KeyName varchar(30) [note: 'اسم المفتاح أو الاسم المختصر للبحث']
  Type int [note: 'نوع العميل (1=شركة, 2=فرد, 3=موظف)']
  Category_Id bigint [note: 'الربط بجدول فئات العملاء']
  SearchName varchar(35) [note: 'اسم البحث التلقائي']
  ActiveStatus int [note: 'مؤشر حالة نشاط العميل']
  InactivationReason text [note: 'سبب إلغاء تفعيل الملف']
  InactivationTime date [note: 'تاريخ ووقت إلغاء التفعيل']
  InactivationUser bigint [note: 'الموظف الذي ألغى التفعيل']
  CustomerNumber varchar(30) [note: 'رقم العميل المُدخل يدويًا']
  CreditStatus char(1) [note: 'حالة الائتمان']
  CreditReason varchar(60) [note: 'سبب تغيير حالة الائتمان']
  CreditTime date [note: 'تاريخ ووقت تغيير حالة الائتمان']
  CreditUser bigint [note: 'المستخدم الذي تغير حالة الائتمان']
  RevenuePotentialCatering decimal(30,4) [note: 'الإيرادات المحتملة للحفلات']
  RevenuePotentialRooms decimal(30,4) [note: 'الإيرادات المحتملة للغرف']
  ViewFrontOffice int [note: 'مرئي في الواجهة الأمامية']
  ViewSales int [note: 'مرئي في المبيعات']
  PreferredCurrency_Id bigint [note: 'عملة العميل المفضلة']
  CanDelete int [note: 'إمكانية حذف الملف الشخصي']
  Language_Id bigint [note: 'لغة العميل المفضلة']
  NationalityCountry_Id bigint [note: 'جنسية العميل أو الدولة Tابع لها']
  NoMailing int [note: 'إيقاف المراسلات']
  TraceFreq int [note: 'معدل تكرار التتبع']
  SaveGuest int [note: 'الحفظ التلقائي أو الحذف بعد فترة']
  Policy_Id bigint [note: 'السياسة المستخدمة لهذا الضيف']
  WebLogin varchar(60) [note: 'اسم المستخدم لحجوزات الويب']
  WebPassword varchar(30) [note: 'كلمة المرور لحجوزات الويب']
  Global_Id bigint [note: 'المُعرف العالمي']
}

// جدول الحسابات المالية الفرعية / الحسابات التابعة (كان يسمى ZFAC)
Table FinancialAccounts {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الحساب المالي (ZFAC_ID)']
  Customer_Id bigint [note: 'مرجع مرتبط بجدول العملاء']
  LongDescription varchar(30) [note: 'الوصف الطويل أو اسم الحساب المالي']
  ExpValidFrom date [note: 'تاريخ بداية الصلاحية التعبيرية']
  ExpValidUntil date [note: 'تاريخ نهاية الصلاحية التعبيرية']
  Autonumber bigint [note: 'الترقيم التلقائي للحسابات المالية']
  Status int [note: 'حالة الحساب المالي (0=مفتوح, 1=مغلق)']
}

// جدول رأس المستندات أو الفواتير المالية (كان يسمى AHDR)
Table InvoiceHeaders {
  Id bigint [pk, note: 'المُعرف الفريد لرأس المستند أو الفاتورة (AHDR_ID)']
  InvoiceDate date [note: 'تاريخ إصدار الفاتورة أو المستند المالي']
  OriginalInvoiceNo varchar(60) [note: 'رقم الفاتورة الأصلي']
  VoucherNo varchar(60) [note: 'رقم السند أو القسيمة المرتبطة بالحركة']
  FolioNo varchar(60) [note: 'رقم الفوليو أو الحساب الفرعي للنزيل']
  ArNo varchar(20) [note: 'رقم حساب القبض المرتبط بهذه الفاتورة']
  Meals varchar(100) [note: 'تفاصيل الوجبات أو خطة الوجبات']
  GuestProfile_Id bigint [note: 'مُعرف الضيف أو النزيل في جدول البروفايلات']
  Account_Id bigint [note: 'مُعرف حساب القبض المرتبط بجدول الحسابات']
  Invoice_Id bigint [note: 'رابط إلى سجل الفاتورة الأساسية']
  CheckInDate date [note: 'تاريخ الوصول أو التسكين']
  CheckOutDate date [note: 'تاريخ المغادرة']
  DueDate date [note: 'تاريخ استحقاق سداد الفاتورة المالية']
  Currency_Id bigint [note: 'مُعرف العملة المستخدمة في المعاملة']
  Amount decimal(30,4) [note: 'إجمالي مبلغ الفاتورة أو المستند']
  ExchangeRate decimal(30,4) [note: 'سعر الصرف للعملة المستخدمة']
  ForeignAmount decimal(30,4) [note: 'المبلغ بالعملة الأجنبية']
  CrsReservationNo varchar(60) [note: 'رقم الحجز في نظام التوزيع المركزي']
  ReservationCategory_Id bigint [note: 'مُعرف تصنيف أو فئة الحجز']
  ReservationArrival date [note: 'تاريخ وصول الحجز المتوقع']
  ReservationDeparture date [note: 'تاريخ مغادرة الحجز المتوقع']
  BookingDate date [note: 'تاريخ إنشاء أو إتمام الحجز']
}

// جدول سجلات فواتير وحركات حسابات القبض (كان يسمى AINV)
Table InvoiceRecords {
  Id bigint [pk, note: 'المُعرف الفريد لسجلات حسابات القبض (AINV_ID)']
  Account_Id bigint [note: 'رابط إلى حساب القبض الأساسي']
  PaymentPos_Id varchar(12) [note: 'رابط لسجل الدفع في نقاط البيع']
  Amount decimal(30,4) [note: 'مبلغ أو قيمة حركة حساب القبض']
  Description varchar(30) [note: 'وصف أو تفاصيل الحركة']
  Cashier_Id bigint [note: 'رابط إلى مُعرف الصندوق أو الخزينة']
  TransferDate date [note: 'تاريخ النقل']
  MovementType int [note: 'مؤشر نوع الحركة المدين أو الدائن']
  ClosedTime date [note: 'تاريخ ووقت إغلاق السجل']
  AdjustInvoice_Id bigint [note: 'مُعرف السجل المعدل']
  Remarks varchar(50) [note: 'ملاحظات إضافية']
  PostDate date [note: 'تاريخ الترحيل']
  PcDate date [note: 'تاريخ الكمبيوتر']
  OriginalInvoice_Id bigint [note: 'رقم السجل الأصلي']
  ManualPost int [note: 'مؤشر الترحيل اليدوي']
  RealPostDate date [note: 'تاريخ الترحيل الحقيقي']
  TransferInfo varchar(50) [note: 'معلومات نقل المعاملة']
  CreditAmount decimal(30,4) [default: 0, note: 'جانب الدائن']
  DebitAmount decimal(30,4) [default: 0, note: 'جانب المدين']
  OriginalPos_Id varchar(12) [note: 'مُعرف نقاط البيع الأصلي']
  OriginalDocumentDetail_Id bigint [note: 'مُعرف تفاصيل المستند الأصلي']
  OriginalManualPost int [note: 'مؤشر الحركة الأصلية مرحلة يدوياً']
}

// جدول ربط مدفوعات فواتير حسابات القبض (كان يسمى AIPL)
Table InvoicePaymentLinks {
  Id bigint [pk, note: 'المُعرف الفريد لربط مدفوعات الفواتير']
  DebitInvoiceRecord_Id bigint [note: 'مُعرف سجل حساب القبض المدين']
  CreditInvoiceRecord_Id bigint [note: 'مُعرف سجل حساب القبض الدائن']
  Amount decimal(30,4) [note: 'مبلغ الدفعة أو السداد']
  Cashier_Id bigint [note: 'مُعرف الخزينة']
  PcTime date [note: 'تاريخ ووقت الكمبيوتر']
  PostDate date [note: 'تاريخ ترحيل النظام']
}

// جدول ربط وإعدادات الحدود الائتمانية (كان يسمى ATLK)
Table AccountTypeLinks {
  Id bigint [pk, note: 'المُعرف الفريد لسجل الربط']
  AccountType_Id bigint [note: 'رابط إلى نوع الحساب']
  ProfileType_Id bigint [note: 'رابط إلى أنواع البروفايلات']
  CreditLimit decimal(30,4) [note: 'الحد الائتماني الافتراضي']
}


// جدول الأصناف والخدمات الرئيسي (كان يسمى MFARTICLE)
Table Articles {
  Id bigint [pk, note: 'المُعرف الفريد للصنف']
  ArticleNo varchar(20) [note: 'رقم الصنف']
  Name varchar(60) [note: 'اسم الصنف']
  DefaultPrice decimal(30,4) [note: 'السعر الافتراضي']
  Cost decimal(30,4) [note: 'التكلفة']
  ArticleType char(1) [note: 'نوع الصنف']
  IsPrepaid int [note: 'مدفوع مقدماً']
  MainGroup_Id bigint [note: 'رابط إلى المجموعة الرئيسية']
}

// جدول العملات الرئيسي (كان يسمى MFCURRENCY)
Table Currencies {
  Id bigint [pk, note: 'المُعرف الفريد للعملة']
  Abbreviation varchar(4) [note: 'الاختصار']
  Name varchar(80) [note: 'اسم العملة الكامل']
  Symbol varchar(3) [note: 'رمز العملة']
  ExchangeRate decimal(9,4) [note: 'سعر الصرف']
  UtcCode bigint [note: 'رمز التوقيت العالمي']
  PrimaryCurrency char(1) [note: 'العملة الأساسية']
}

// جدول تفاصيل الفواتير (كان يسمى ADET)
Table InvoiceDetails {
  Id bigint [pk, note: 'المُعرف الفريد لبند التفاصيل']
  Header_Id bigint [note: 'رابط رأس المستند المالي']
  Article_Id bigint [note: 'رابط جدول الأصناف']
  Description varchar(120) [note: 'وصف البند']
  Amount decimal(30,4) [note: 'قيمة البند']
}




// جدول فترات الوجبات الرئيسية
Table MealPeriods {
  Id varchar(12) [pk, note: 'المُعرف الفريد لفترة الوجبة']
  MealPeriodNumber char(1) [note: 'رقم فترة الوجبة']
  Name varchar(20) [note: 'اسم فترة الوجبة']
  StartTime bigint [note: 'وقت البدء']
  EndTime bigint [note: 'وقت الانتهاء']
}

// جدول رابط فترات الوجبات بمنافذ البيع
Table MealPeriodLinks {
  Id varchar(12) [pk, note: 'المُعرف الفريد للرابط']
  MealPeriod_Id varchar(12) [note: 'معرف فترة الوجبة']
  Outlet_Id varchar(12) [note: 'معرف منفذ البيع']
}

// جدول أصناف قائمة الطعام الرئيسية
Table MenuArticles {
  Id varchar(12) [pk, note: 'المُعرف الفريد للصنف بالقائمة']
  Article_Id bigint [note: 'معرف الصنف الأساسي']
  ScreenDisplay varchar(20) [note: 'العرض على الشاشة']
  Price decimal(8,2) [note: 'السعر']
  FlexPrice char(1) [note: 'سعر مرن']
  ArticleType char(1) [note: 'نوع الصنف']
  Browseable char(1) [note: 'قابل للتصفح']
  Bookable char(1) [note: 'قابل للحجز']
  RootNode char(1) [note: 'العقدة الرئيسية']
  TouchGroupId varchar(12) [note: 'مجموعة اللمس']
  SortOrder decimal(10,4) [note: 'ترتيب الفرز']
  DdArticleNumber varchar(6) [note: 'رقم موزع المشروبات']
  UdArticleNo varchar(8) [note: 'رقم الصنف المخصص']
  Outlet_Id varchar(12) [note: 'معرف منفذ البيع']
  Menu_Id varchar(12) [note: 'معرف القائمة']
  TaxDefinition_Id varchar(12) [note: 'معرف الضريبة']
  CourseNo int [note: 'رقم الدورة']
  PrinterPool_Id varchar(12) [note: 'معرف مجموعة الطابعات']
  PrintHeadingOnly char(1) [note: 'طباعة العنوان فقط']
  ForceModifier char(1) [note: 'إجبار الإضافات']
  ModifierGroupId varchar(12) [note: 'مجموعة الإضافات']
  PermissionLevel int [note: 'مستوى الصلاحية']
  McProductId bigint [note: 'معرف قديم']
  LinkedMenuArticle_Id varchar(12) [note: 'الصنف المرتبط']
  Inactive char(1) [note: 'غير مفعل']
  IconId varchar(12) [note: 'معرف الأيقونة']
  CanvasColor bigint [note: 'لون اللوحة']
  DefaultColor bigint [note: 'اللون الافتراضي']
  MaxCount decimal [note: 'الحد الأقصى للكمية']
  ActCount decimal [note: 'الكمية الفعلية']
  Channel2 varchar(10) [note: 'قناة الاتصال الثانية']
  DuplicatePoolId varchar(12) [note: 'معرف مجموعة الطباعة البديلة']
}



// جدول رابط القوائم بمنافذ البيع
// إصلاح حقل المنفذ في جدول ارتباط القوائم لتوافق البنية الصحيحة
Table MenuLinks {
  Id varchar(12) [pk, note: 'المُعرف الفريد لسجل رابط القائمة']
  OutletId varchar(12) [note: 'معرف منفذ البيع'] // ملاحظة: تأكد من اسم العمود الفعلي في قاعدة البيانات (مثل Outlet_Id أو OutletId)
  MenuId varchar(12) [note: 'معرف قائمة الطعام']
  DefaultMenu char(1) [note: 'قائمة افتراضية']
  ValidDate bigint [note: 'تاريخ الصلاحية']
  FromTime bigint [note: 'وقت البدء']
  ToTime bigint [note: 'وقت الانتهاء']
  Priority int [note: 'الأولوية']
  ValidDateV8 date [note: 'تاريخ الصلاحية القياسي']
  FromTimeV8 date [note: 'وقت البدء القياسي']
  ToTimeV8 date [note: 'وقت الانتهاء القياسي']
}

// جدول منافذ البيع الرئيسية والفروع
Table Outlets {
  Id varchar(12) [pk, note: 'المُعرف الفريد لمنفذ البيع']
  ExternalId char(4) [note: 'المعرف الخارجي']
  ShortName varchar(20) [note: 'الاسم المختصر']
  Name varchar(40) [note: 'اسم منفذ البيع']
  Address1 varchar(60) [note: 'العنوان الأول']
  Address2 varchar(60) [note: 'العنوان الثاني']
  City varchar(40) [note: 'المدينة']
  Zip char(10) [note: 'الرمز البريدي']
  BookingDate bigint [note: 'تاريخ الحجز الحالي']
  ConfirmPayType char(1) [note: 'تأكيد نوع الدفع']
  PromptForGuests char(1) [note: 'مطالبة بالضيوف']
  PromptForSeat char(1) [note: 'مطالبة بالمقعد']
  CancelRoomTable char(1) [note: 'إلغاء طاولة الغرفة']
  CancelFastCash char(1) [note: 'إلغاء الدفع النقدي السريع']
  PictureId varchar(12) [note: 'معرف الصورة']
  SortModeId varchar(12) [note: 'وضع الفرز']
  DefaultMenuId varchar(12) [note: 'القائمة الافتراضية']
  Width decimal(8,0) [note: 'العرض']
  Length decimal(8,0) [note: 'الطول']
  StartAt int [note: 'نقطة البداية']
  ForceTable char(1) [note: 'إجبار اختيار الطاولة']
  BookBySeat char(1) [note: 'الحجز حسب المقعد']
  TableNumberScheme int [note: 'مخطط ترقيم الطاولات']
  LogoffTimer int [note: 'مؤقت تسجيل الخروج']
  UniqueCheck char(1) [note: 'شيك فريد']
  CheckPrinterSelection varchar(8) [note: 'اختيار طابعة الشيكات']
  TempPrinterSelection varchar(8) [note: 'اختيار الطابعة المؤقتة']
  McDeviceId bigint [note: 'معرف قديم']
  TextButtons char(1) [note: 'الأزرار النصية']
  FontColor bigint [note: 'لون الخط']
  DefaultOutletRegionId varchar(12) [note: 'منطقة المنفذ الافتراضية']
  GroupArticleDetailPrint char(1) [note: 'طباعة تفاصيل الأصناف المجمعة']
}


// جدول معاملات وإعدادات النظام الرئيسية
Table SystemParameters {
  Id varchar(12) [pk, note: 'المُعرف الفريد لسجل المعاملات']
  DatabaseVersion varchar(10) [note: 'إصدار قاعدة البيانات']
  DatabaseBuilt char(3) [note: 'بناء قاعدة البيانات']
  SetupLang char(2) [note: 'لغة الإعداد']
  SystemDate bigint [note: 'تاريخ النظام']
  PropertyName varchar(100) [note: 'اسم المنشأة']
  MaxPos decimal(4,0) [note: 'الحد الأقصى لنقاط البيع']
  MaxMgrPos decimal(4,0) [note: 'الحد الأقصى لمديري النقاط']
  MaxHht decimal(4,0) [note: 'الحد الأقصى لأجهزة المحمول']
  ExpireDate bigint [note: 'تاريخ انتهاء الترخيص']
  LicenseCode varchar(20) [note: 'كود الترخيص']
  NoniteTransfer char(1) [note: 'مؤشر التحويل']
  TipPaidOutCombined char(1) [note: 'دفع البقشيش مجتمعاً']
  RoomTblCheck char(1) [note: 'فحص طاولة الغرفة']
  DefaultCurrencyId varchar(12) [note: 'العملة الافتراضية']
  FoTransferMode char(1) [note: 'وضع تحويل الإيرادات']
  ArticleNumberDigits decimal(1,0) [note: 'عدد خانات رقم الصنف']
  ArticleNumberExactLength char(1) [note: 'طول رقم الصنف الدقيق']
  SortCheckBy char(1) [note: 'فرز الشيك']
  LongArticleSearch char(1) [note: 'البحث الموسع']
  QuestPrint char(1) [note: 'طباعة الاستفسارات']
  PrintSettlementDetail char(1) [note: 'طباعة التسوية']
  PrintTransfers char(1) [note: 'طباعة التحويلات']
  TroubleBook char(1) [note: 'سجل الأعطال']
  FoCheckDisplay char(1) [note: 'عرض شيكات الفرونت أوفيس']
  TaxOnRoomBill char(1) [note: 'الضريبة على فاتورة الغرفة']
  NitePrinterId varchar(12) [note: 'طابعة التقفيل الليلي']
  TimeAndAttendance char(1) [note: 'الحضور والانصراف']
  PictureId varchar(12) [note: 'معرف الصورة']
  DefaultImageId varchar(12) [note: 'الصورة الافتراضية']
  TouchGroupImageId varchar(12) [note: 'صورة مجموعات اللمس']
  NormalCheckImageId varchar(12) [note: 'صورة الشيك العادي']
}

// جدول إضافات وملحقات المدفوعات
Table PaymentAdditions {
  Id varchar(12) [pk, note: 'المُعرف الفريد لملحقات المدفوعات']
  Signature blob [note: 'التوقيع الرقمي']
  PaymentId varchar(12) [note: 'معرف عملية الدفع الرئيسية']
}

// جدول أنواع وسائل الدفع الرئيسية
Table PaymentTypes {
  Id varchar(12) [pk, note: 'المُعرف الفريد لطريقة الدفع']
  PayTypeName varchar(20) [note: 'اسم طريقة الدفع']
  PayGroup char(6) [note: 'مجموعة الدفع']
  DiscountGroup char(8) [note: 'مجموعة الخصم المرتبطة']
  PayTypeAbbr char(6) [note: 'الاختصار']
  CurrencyId varchar(12) [note: 'معرف العملة']
  ImageId varchar(12) [note: 'معرف الأيقونة']
  CopyCount decimal(1,0) [note: 'عدد النسخ المطبوعة']
  DiscountPercentage decimal(5,2) [note: 'نسبة الخصم']
  QuestTip char(1) [note: 'طلب البقشيش']
  IsOnline char(1) [note: 'دفع إلكتروني']
  SortOrder decimal [note: 'ترتيب العرض']
  Permission decimal(3,0) [note: 'الصلاحية']
  ExternalShortcut varchar(6) [note: 'الاختصار الخارجي']
  QuestVoucher char(1) [note: 'طلب قسيمة']
  Paymaster varchar(8) [note: 'حساب الحجز الرئيسي']
  IsHht char(1) [note: 'تفعيل على الأجهزة المحمولة']
  ArticleDiscount char(1) [note: 'خصم على الصنف']
  NonDdWarning char(1) [note: 'تحذير عدم الصرف']
  IsCp char(1) [note: 'معاملات تبادلية']
  OverchargeMode char(1) [note: 'وضع الفائض']
  PackageClearing char(1) [note: 'تسوية الحزم']
  DiscountValue decimal(6,2) [note: 'قيمة الخصم الثابت']
  QuestCheckoutTax char(1) [note: 'ضريبة المغادرة']
  InternalShortcut varchar(6) [note: 'الاختصار الداخلي']
  QuestInstallments char(1) [note: 'طلب أقساط']
  MaxInstallments decimal(4,0) [note: 'الحد الأقصى للأقساط']
  SafTPayMechanism varchar(10) [note: 'آلية التقرير الضريبي']
  PrepaidDiscountId varchar(12) [note: 'خصم الدفع المسبق']
  DebitOnly char(1) [note: 'مدين فقط']
}

// جدول أجهزة نقاط البيع والكاشيرات الرئيسية
Table PosTerminals {
  Id varchar(12) [pk, note: 'المُعرف الفريد لجهاز نقطة البيع']
  PosNum char(3) [note: 'الرقم الداخلي']
  OutletId varchar(12) [note: 'معرف منفذ البيع']
  MacAddress char(12) [note: 'عنوان MAC']
  IpAddressV4 char(15) [note: 'عنوان IP V4']
  IpAddressV6 char(39) [note: 'عنوان IP V6']
  IsOnline char(1) [note: 'حالة الاتصال']
  OnlineSince bigint [note: 'وقت الاتصال']
  CheckPrinterId varchar(12) [note: 'معرف طابعة الشيكات']
  JournalPrinterId varchar(12) [note: 'معرف طابعة اليومية']
  CashPrinterId varchar(12) [note: 'معرف طابعة النقدية']
  TempPrinterPoolId varchar(12) [note: 'مجموعة الطابعات المؤقتة']
  TempCashPoolId varchar(12) [note: 'مجموعة طابعات النقدية المؤقتة']
  CashDrawer char(1) [note: 'درج النقدية']
  AutoLogin char(1) [note: 'تسجيل دخول تلقائي']
  WaiterCardId varchar(12) [note: 'بطاقة الموظف']
  CreditCardId varchar(12) [note: 'بطاقة الائتمان']
  RoomCardId varchar(12) [note: 'بطاقة الغرفة']
  ReportPrinterId varchar(12) [note: 'طابعة التقارير']
  Location varchar(100) [note: 'الموقع']
  CDisplay char(1) [note: 'شاشة العميل']
  IdleText1 varchar(40) [note: 'نص السكون 1']
  IdleText2 varchar(40) [note: 'نص السكون 2']
  Language char(2) [note: 'لغة الشاشة']
  RepeatTime bigint [note: 'زمن التكرار']
  AnimTimer bigint [note: 'مؤقت الحركة']
  NextNumber decimal(4,0) [note: 'الرقم التالي']
  XResolution decimal(4,0) [note: 'الدقة الأفقية']
  YResolution decimal(4,0) [note: 'الدقة الرأسية']
  ScreenDiameter decimal(6,2) [note: 'قياس الشاشة']
  BaseButtonHeight decimal(3,0) [note: 'ارتفاع الأزرار']
  BaseButtonWidth decimal(3,0) [note: 'عرض الأزرار']
}


// جدول طاولات المطعم والقاعات الرئيسية
Table Tables {
  Id varchar(12) [pk, note: 'المُعرف الفريد للطاولة']
  TableNo char(4) [note: 'رقم الطاولة']
  MaxSeats decimal(3,0) [note: 'الحد الأقصى للمقاعد']
  OutletId varchar(12) [note: 'معرف منفذ البيع']
}



// جدول بيانات إيرادات شركاء الفنادق أو نقاط البيع الإحصائية (كان يسمى SRP)
Table StatisticalPartnerRevenue {
  Id bigint [pk, note: 'المُعرف الفريد للسجل (SRP_ID)']
  ReportDate timestamp [note: 'تاريخ السجل (SRP_DATE)']
  DepartmentCode_Id bigint [note: 'معرف الارتباط بكود القسم أو التكلفة (SRP_ZDCO_ID)']
  NetRev_D decimal(30,4) [note: 'الإيراد الصافي اليومي (SRP_NETREV_D)']
  GrossRev_D decimal(30,4) [note: 'الإيراد الإجمالي اليومي (SRP_GROSSREV_D)']
  NetRev_M decimal(30,4) [note: 'الإيراد الصافي الشهري (SRP_NETREV_M)']
  GrossRev_M decimal(30,4) [note: 'الإيراد الإجمالي الشهري (SRP_GROSSREV_M)']
  NetRev_Y decimal(30,4) [note: 'الإيراد الصافي السنوي (SRP_NETREV_Y)']
  GrossRev_Y decimal(30,4) [note: 'الإيراد الإجمالي السنوي (SRP_GROSSREV_Y)']
  Partner_Id bigint [note: 'معرف الفندق الشريك (SRP_PARTNER_ID)']
  Imported int [note: 'مؤشر التحكم بالاستيراد (SRP_IMPORTED)']
  PointOfSale_Id bigint [note: 'معرف الارتباط بالفندق الشريك عبر موصل الفنادق (SRP_WPHS_ID)']
  DepartmentLongDesc varchar(30) [note: 'الوصف الطويل لقسم الفندق الشريك (SRP_ZDCO_LONGDESC)']
  DepartmentNumericDesc int [note: 'الوصف الرقمي لقسم الفندق الشريك (SRP_ZDCO_NUMERICDESC)']
  DepartmentGroupLongDesc varchar(30) [note: 'الوصف الطويل لمجموعة الأقسام من الفندق الشريك (SRP_ZDCG_LONGDESC)']
  DepartmentCdt int [note: 'كود تفاصيل القسم من الفندق الشريك (SRP_ZDCO_CDT)']
  RevenueType int [default: 0, note: 'نوع الإيراد: 0 قياسي، 1 فندق، 2 وديعة، 3 قسيمة (SRP_TYPE)']
}

// جدول ربط عمولات وكلاء السفر (كان يسمى TCCL)
Table TravelAgentCommissionLinks {
  Id bigint [pk, note: 'المُعرف الفريد للسجل (TCCL_ID)']
  CommissionCode_Id bigint [note: 'رابط إلى كود عمولة وكيل السفر (TCCL_TCOD_ID)']
  CalculationRule_Id bigint [note: 'رابط إلى قاعدة حساب عمولة وكيل السفر (TCCL_TCCR_ID)']
  FromDate date [note: 'تاريخ بداية الصلاحية للحساب (TCCL_FROMDATE)']
  ToDate date [note: 'تاريخ نهاية الصلاحية للحساب (TCCL_TODATE)']
}
// جدول قواعد حساب عمولات وكلاء السفر (كان يسمى TCCR)
Table TravelAgentCommissionRules {
  Id bigint [pk, note: 'المُعرف الفريد للقاعدة (TCCR_ID)']
  ShortDescription varchar(3) [note: 'الوصف المختصر لكود العمولة (TCCR_SHORTDESC)']
  LongDescription varchar(30) [note: 'الوصف الطويل لكود العمولة (TCCR_LONGDESC)']
  CalcOnNetRev int [note: 'مؤشر حساب العمولة على الإيراد الصافي - 1 للحساب على الصافي (TCCR_CALC_ON_NETREV)']
  VatOnCommission decimal(30,4) [note: 'نسبة ضريبة القيمة المضافة المضافة إلى العمولة (TCCR_VAT_ON_COMMISSION)']
  Inactive int [note: 'مؤشر إلغاء تفعيل القاعدة - 1 = Inactive (TCCR_INACTIVE)']
  DisplayOrder int [note: 'ترتيب العرض (TCCR_DISPLORDER)']
  AdditionType int [note: 'نوع الإضافة: 0 = لكل كود قسم، 1 = لكل ليلة، 2 = لكل إقامة (TCCR_ADDITIONTYPE)']
  Rule int [note: 'قاعدة الحساب: 0 = جمع/إضافة، 1 = ضرب (TCCR_RULE)']
  Value decimal(30,4) [note: 'القيمة المالية أو النسبة الخاصة بقاعدة العمولة (TCCR_VALUE)']
}
// جدول ربط أكواد أقسام عمولات وكلاء السفر (كان يسمى TCCZ)
Table TravelAgentCommissionDepartmentLinks {
  Id bigint [pk, note: 'المُعرف الفريد للسجل (TCCZ_ID)']
  DepartmentCode_Id bigint [note: 'رابط كود القسم (TCCZ_ZDCO_ID)']
  CalculationRule_Id bigint [note: 'رابط إلى قواعد حساب عمولات وكلاء السفر (TCCZ_TCCR_ID)']
}
// جدول أكواد العمولات (كان يسمى TCOD)
Table TravelAgentCommissionCodes {
  Id bigint [pk, note: 'المُعرف الفريد للسجل (TCOD_ID)']
  ShortDescription varchar(3) [note: 'الوصف المختصر لكود العمولة (TCOD_SHORTDESC)']
  LongDescription varchar(30) [note: 'الوصف الطويل لكود العمولة (TCOD_LONGDESC)']
  DisplayOrder int [note: 'ترتيب العرض (TCOD_DISPLORDER)']
  Multiplier varchar(200) [note: 'حقل قديم تم الاستغناء عنه - Obsolete (TCOD_MULTIPLIER)']
  Additions varchar(200) [note: 'حقل قديم تم الاستغناء عنه - Obsolete (TCOD_ADDITIONS)']
  IsDefault int [note: 'مؤشر كود العمولة الافتراضي (TCOD_DEFAULT)']
  Inactive int [note: 'مؤشر إلغاء تفعيل الكود: 1 = Inactive (TCOD_INACTIVE)']
}
// جدول أنشطة أو مهام مستخدمي النظام (كان يسمى ULAT)
Table UserActivities {
  Id bigint [pk, note: 'المُعرف الفريد للسجل (ULAT_ID)']
  User_Id bigint [note: 'مُعرف المستخدم (ULAT_XCMS_ID)']
  ActivityType_Id bigint [note: 'مُعرف نوع النشاط أو المهمة (ULAT_WATY_ID)']
}


// جدول أقسام أو إدارات الفندق والأقسام التشغيلية (كان يسمى WHDE)
Table HotelDepartments {
  Id bigint [pk, note: 'المُعرف الفريد للسجل (WHDE_ID)']
  ShortDescription varchar(3) [note: 'الوصف المختصر أو كود القسم (WHDE_SHORTDESC)']
  LongDescription varchar(30) [note: 'الوصف الطويل أو اسم القسم (WHDE_LONGDESC)']
  DisplayOrder int [note: 'ترتيب العرض (WHDE_DISPLORDER)']
  Inactive int [note: 'مؤشر عدم النشاط: 0=active, 1=inactive (WHDE_INACTIVE)']
  Role int [note: 'دور أو تصنيف القسم التشغيلي: 1=Housekeeping, 2=Maintenance, 3=Kitchen, 4=Restaurants (WHDE_ROLE)']
}


// جدول المفقودات والمعثورات في الفندق (كان يسمى WLAF)
Table LostAndFound {
  Id bigint [pk, note: 'المُعرف الفريد للسجل (WLAF_ID)']
  LostAndFoundGroup_Id bigint [note: 'رابط إلى مجموعة المفقودات (WLAF_WLFG_ID)']
  Customer_Id bigint [note: 'رابط إلى الشخص فاقد أو عاثر الغرض حسب نوع البلاغ (WLAF_XCMS_ID)']
  UserCustomer_Id bigint [note: 'المستخدم الذي أدخل المعلومات (WLAF_USER_XCMS_ID)']
  Room_Id bigint [note: 'الغرفة التي فقد أو عثر فيها على الغرض (WLAF_YRMS_ID)']
  FunctionSpace_Id bigint [note: 'المساحة الوظيفية التي فقد أو عثر فيها على الغرض (WLAF_YFSC_ID)']
  Type int [note: 'نوع البلاغ: 1 = Lost, 2 = Found (WLAF_TYPE)']
  LongDescription varchar(60) [note: 'الوصف الطويل أو تفاصيل الغرض (WLAF_LONGDESC)']
  EventDate timestamp [note: 'تاريخ الفقد أو العثور حسب نوع البلاغ (WLAF_WHEN)']
  WhereLocation varchar(30) [note: 'المكان الذي فقد أو عثر فيه إذا لم يكن في غرفة أو مساحة محددة (WLAF_WHERE)']
  EntryDate timestamp [note: 'تاريخ إدخال معلومات البلاغ (WLAF_DATE)']
  KeepUntilDate timestamp [note: 'التاريخ حتى متى يجب الاحتفاظ بالغرض (WLAF_KEEPUNTILDATE)']
  FreeText varchar(1000) [note: 'نص حر لوصف تفاصيل إضافية (WLAF_FREETEXT)']
  Picture text [note: 'صورة الغرض المعثور عليه (WLAF_PICTURE)']
  ConnectedLostAndFound_Id bigint [note: 'معرف السجل المرتبط لربط المفقودات بالمعثورات (WLAF_FOUND_WLAF_ID)']
  NumberCycle bigint [note: 'رقم متسلسل يتم توليده تلقائياً (WLAF_NUMBERCYCLE)']
  ResolveDate timestamp [note: 'تاريخ حل البلاغ أو إغلاقه (WLAF_RESOLVEDATE)']
  ResolvedUserCustomer_Id bigint [note: 'المستخدم الذي قام بحل أو إغلاق البلاغ (WLAF_RESOLVED_USER_XCMS_ID)']
  PublicPlace_Id bigint [note: 'رابط للأماكن العامة (WLAF_YPUB_ID)']
  PictureFormat int [note: 'صيغة صورة الغرض: 0 = JPEG, 1 = BMP (WLAF_PICTURE_FORMAT)']
}

// جدول أنواع العناوين (كان يسمى XATY)
Table AddressTypes {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XATY_ID)']
  ShortDescription varchar(3) [note: 'الوصف القصير لنوع العنوان (XATY_SHORTDESC)']
  LongDescription varchar(30) [note: 'الوصف الطويل أو التسمية التفصيلية (XATY_LONGDESC)']
  DisplayOrder int [note: 'ترتيب عرض أنواع العناوين (XATY_DISPLORDER)']
  Role int [note: 'دور أو نوع العنوان: 1 = Billing Address, 2 = Mailing Address (XATY_ROLE)']
  Inactive int [note: 'مؤشر حالة النشاط: 0 = active, 1 = inactive (XATY_INACTIVE)']
}
// جدول إعدادات الفوترة أو تعليمات الفواتير للعملاء (كان يسمى XBIL)
Table CustomerBillingInstructions {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XBIL_ID)']
  Customer_Id bigint [note: 'رابط إلى جدول العملاء (XBIL_XCMS_ID)']
  DepartmentConfig_Id bigint [note: 'رابط إلى قسم الفوترة أو تعليمات الفوترة (XBIL_ZDCO_ID)']
  BillingCode_Id bigint [note: 'رابط إلى كود تعليمات الفوترة أو كود قسم الإيرادات (XBIL_ZBIC_ID)']
  Type int [note: 'نوع القواعد: 1 = include, 2 = exclude (XBIL_TYPE)']
}


// جدول فئات العملاء (كان يسمى XCCA)
Table CustomerCategories {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XCCA_ID)']
  InternalCategory int [note: 'الفئة الداخلية لدور التصنيف في النظام (XCCA_INTERNALCATEGORY)']
  ShortDescription varchar(3) [note: 'الوصف القصير لفئة العميل (XCCA_SHORTDESC)']
  LongDescription varchar(30) [note: 'الوصف الطويل أو التسمية التفصيلية (XCCA_LONGDESC)']
  CustomerType int [note: 'يحدد ما إذا كانت الفئة تنطبق على الشركات أو الأفراد (XCCA_XCMSTYPE)']
  DisplayOrder int [note: 'ترتيب عرض فئات العملاء (XCCA_DISPLORDER)']
  Inactive int [note: 'مؤشر عدم النشاط: 0 = active, 1 = inactive (XCCA_INACTIVE)']
  ToInvoice int [note: 'مؤشر الإتاحة للفوترة لمنظمي الرحلات: 1 = Available (XCCA_TO_INVOICE)']
}
// جدول تفاصيل أو إعدادات قطاعات العملاء / الشركات (كان يسمى XCCD)
Table CustomerCompanyDetails {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XCCD_ID)']
  Division varchar(30) [note: 'القطاع أو القسم الإداري (XCCD_DIVISION)']
  PrimarySalesOffice varchar(30) [note: 'مكتب المبيعات الرئيسي (XCCD_PRIMSLSOFF)']
  EmployeeNumber int [note: 'عدد الموظفين (XCCD_EMPNUM)']
  TravelAgentCurrency_Id bigint [note: 'عملة عمولة وكيل السفر (XCCD_TAP_ZCUR_ID)']
  CommissionCode_Id bigint [note: 'ربط كود العمولة لوكلاء السفر والمصادر (XCCD_TCOD_ID)']
}
// جدول ربط العملاء ببعضهم البعض (كان يسمى XCCL)
Table CustomerLinks {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XCCL_ID)']
  FromCustomer_Id bigint [note: 'العميل المصدر أو المرتبط منه (XCCL_FROM_XCMS_ID)']
  ToCustomer_Id bigint [note: 'العميل المستهدف أو المرتبط به (XCCL_TO_XCMS_ID)']
}



// جدول أنواع وسائل الاتصال (كان يسمى XCMT)
Table CommunicationTypes {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XCMT_ID)']
  ShortDescription varchar(3) [note: 'الوصف القصير لنوع الاتصال (XCMT_SHORTDESC)']
  LongDescription varchar(30) [note: 'الوصف الطويل أو المسمى التفصيلي (XCMT_LONGDESC)']
  DisplayOrder int [note: 'ترتيب عرض أنواع وسائل الاتصال (XCMT_DISPLORDER)']
  Type int [note: 'نوع الوسيلة: 1 = Email, 2 = Homepage, 3 = Telefax, 4 = Telephone (XCMT_TYPE)']
  Inactive int [note: 'مؤشر عدم النشاط: 0 = active, 1 = inactive (XCMT_INACTIVE)']
  RegularExpression_Id bigint [note: 'الربط بتعبير نمطي للتحقق من صحة الإدخال (XCMT_WRXP_ID)']
  PhoneRole int [note: 'دور أو طبيعة رقم الهاتف: 1 = Mobile phone (XCMT_PHONEROLE)']
}

// جدول فئات الملاحظات (كان يسمى XCNC)
Table NotesCategories {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XCNC_ID)']
  ShortDescription varchar(3) [note: 'الوصف القصير لفئات الملاحظات (XCNC_SHORTDESC)']
  LongDescription varchar(30) [note: 'الوصف الطويل أو المسمى التفصيلي (XCNC_LONGDESC)']
  TableLinkedTo int [note: 'الجدول المرتبط به الفئة: 0=Profile, 1=BookingMaster, 2=Reservation, 3=Event (XCNC_TABLELINKEDTO)']
  DisplayOrder int [note: 'ترتيب عرض فئات الملاحظات (XCNC_DISPLORDER)']
  Inactive int [note: 'مؤشر عدم النشاط: 0 = active, 1 = inactive (XCNC_INACTIVE)']
  Restriction int [note: 'قيود الاستخدام: 1 = yes, user rights apply (XCNC_RESTRICTION)']
  Upload int [note: 'مؤشر المزامنة مع الجدول الرئيسي: 1 = Yes (XCNC_UPLOAD)']
  PopupProfile int [default: 0, note: 'رسالة منبثقة عند تعديل ملف العميل (XCNC_POPUP_PROFILE)']
  PopupReservation int [default: 0, note: 'رسالة منبثقة عند تعديل الحجز (XCNC_POPUP_RESERVATION)']
  PopupCcm int [default: 0, note: 'رسالة منبثقة عند تعديل CCM (XCNC_POPUP_CCM)']
  PopupBillingOpen int [default: 0, note: 'رسالة منبثقة عند فتح الفاتورة (XCNC_POPUP_BILLINGOPEN)']
  PopupTableReservation int [note: 'رسالة منبثقة لحجوزات الطاولات (XCNC_POPUP_TABLERESERVATION)']
}

// جدول ربط فئات الملاحظات بكيانات وأقسام النظام (كان يسمى XCNL)
Table NotesCategoryLinks {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XCNL_ID)']
  NotesCategory_Id bigint [note: 'مُعرف فئة الملاحظات المرتبطة (XCNL_XCNC_ID)']
  Department_Id bigint [note: 'مُعرف القسم أو الكيان المرتبط (XCNL_WHDE_ID)']
}

// 🔗 ربط علاقات جدول روابط فئات الملاحظات مع الجداول المرتبطة
Ref: NotesCategoryLinks.NotesCategory_Id > NotesCategories.Id
Ref: NotesCategoryLinks.Department_Id > HotelDepartments.Id
// جدول ملاحظات العملاء والكيانات الفعلية (كان يسمى XCNO)
Table CustomerNotes {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XCNO_ID)']
  NotesCategory_Id bigint [note: 'الربط بفئة الملاحظات (XCNO_XCNC_ID)']
  Table_Id bigint [note: 'معرف الجدول الذي تنتمي إليه الملاحظة (XCNO_TABLE_ID)']
  Notes text [note: 'نص الملاحظة الفعلية (XCNO_NOTES)']
