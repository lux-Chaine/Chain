  IssuePlace varchar(30) [note: 'مكان أو مدينة إصدار المستند (XPDC_ISSUEPLACE)']
  FathersName varchar(30) [note: 'اسم والد الضيف لتقارير السياسات في تركيا (XPDC_FATHERS_NAME)']
  MothersName varchar(30) [note: 'اسم والدة الضيف لتقارير السياسات في تركيا (XPDC_MOTHERS_NAME)']
  RegisterCity varchar(30) [note: 'مدينة التسجيل (XPDC_REGISTER_CITY)']
  RegisterMunicipal varchar(30) [note: 'بلدية التسجيل (XPDC_REGISTER_MUNICIPAL)']
  RegisterStreet varchar(30) [note: 'شارع التسجيل (XPDC_REGISTER_STREET)']
  BornCountry_Id bigint [note: 'دولة الميلاد (XPDC_BORN_XCOU_ID)']
  IssueCountry_Id bigint [note: 'معرف دولة الإصدار (XPDC_ISSUE_XCOU_ID)']
  BirthPlace varchar(50) [note: 'مكان الميلاد (XPDC_BIRTHPLACE)']
  IssueTown_Id bigint [note: 'معرف مدينة الإصدار (XPDC_ISSUE_WTWN_ID)']
  BornTown_Id bigint [note: 'معرف مدينة الميلاد (XPDC_BORN_WTWN_ID)']
  IssueState_Id bigint [note: 'ولاية أو مقاطعة الإصدار (XPDC_ISSUE_XSTA_ID)']
  BornState_Id bigint [note: 'ولاية أو مقاطعة الميلاد (XPDC_BORN_XSTA_ID)']
  GlobalId bigint [note: 'المعرف العالمي (XPDC_GLOBALID)']
  Birthday timestamp [note: 'تاريخ الميلاد (XPDC_BIRTHDAY)']
  IsPrimary int [note: 'مؤشر المستند الشخصي الأساسي (XPDC_PRIMARY)']
  FidCrsId varchar(20) [note: 'معرف نظام Fidelio CRS المرتبط (XPDC_FIDCRSID)']
  PersonalNumber varchar(60) [note: 'الرقم الشخصي أو القومي للضيف (XPDC_PERSONALNUMBER)']
}
