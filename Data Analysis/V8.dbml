  GuestViewable int [note: 'تحديد إمكانية إظهار التعليق للضيف: 1 = Viewable, 0 = Not Viewable (XCNO_GUESTVIEWABLE)']
  InternalCode int [note: 'كود داخلي يعتمد معناه على الجدول المرتبط (XCNO_INTERNALCODE)']
  GlobalId bigint [note: 'المعرف العالمي (XCNO_GLOBALID)']
  NotesVarchar varchar(2000) [note: 'ملاحظات بنوع Varchar لتسهيل إدارتها من SQL (XCNO_NOTESVARCHAR)']
  FidCrsId varchar(20) [note: 'معرف نظام الحجز المركزي Fidelio CRS (XCNO_FIDCRSID)']
}
// جدول بيانات اتصالات العملاء الفعلية (كان يسمى XCOM)
Table CustomerCommunications {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XCOM_ID)']
  CommunicationType_Id bigint [note: 'الربط بنوع الاتصال (XCOM_XCMT_ID)']
  Address_Id bigint [note: 'الربط بالعنوان (XCOM_XADR_ID)']
  Customer_Id bigint [note: 'الربط بملف العميل (XCOM_XCMS_ID)']
  TelephoneBook_Id bigint [note: 'الربط بدليل الهاتف (XCOM_WTBE_ID)']
  Value varchar(60) [not null, note: 'القيمة الفعلية للاتصال كبريد أو رقم هاتف (XCOM_VALUE)']
  IsPrimary int [note: 'تحديد ما إذا كانت وسيلة الاتصال أساسية: 1 = Yes, 0 = No (XCOM_PRIMARY)']
  EmployeeCommunicationType_Id bigint [note: 'الربط بأنواع اتصال الموظفين (XCOM_XECT_ID)']
  GlobalId bigint [note: 'المعرف العالمي المستخدم في الفنادق الشريكة (XCOM_GLOBALID)']
  Verified int [note: 'حالة التحقق: 0 = not validated, 1 = valid, 2 = not valid (XCOM_VERIFIED)']
  MailId varchar(100) [note: 'معرف البريد الإلكتروني الخاص بـ Outlook (XCOM_MAILID)']
  FidCrsId varchar(20) [note: 'معرف نظام الحجز المركزي Fidelio CRS (XCOM_FIDCRSID)']
}
// جدول الدول (كان يسمى XCOU)
Table Countries {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XCOU_ID)']
  Iso2 varchar(2) [note: 'كود الدولة المكون من حرفين حسب المعيار الدولي (XCOU_ISO2)']
  Iso3 varchar(3) [note: 'كود الدولة المكون من 3 أحرف حسب المعيار الدولي (XCOU_ISO3)']
  CustomShortDescription varchar(3) [note: 'الوصف القصير المخصص للدولة (XCOU_CUSTSHORTDESC)']
  LongDescription varchar(50) [note: 'الوصف الطويل أو اسم الدولة الكامل (XCOU_LONGDESC)']
  Currency_Id bigint [note: 'الربط بجدول العملات (XCOU_ZCUR_ID)']
  GovernmentId bigint [note: 'معرف حكومي لإحصائيات الدول (XCOU_GVMNT_ID)']
  Nationality varchar(30) [note: 'الجنسية التابعة للدولة (XCOU_NATIONALITY)']
  Continent int [note: 'القارة: 1=Europe, 2=Asia, 3=Africa, 4=Australia, 5=America (XCOU_CONTINENT)']
  AddressType int [note: 'نوع العنوان المستخدم لعرض العنوان الكامل (XCOU_ADDR_TYPE)']
  DisplayOrder int [note: 'ترتيب العرض (XCOU_DISPLORDER)']
  Inactive int [note: 'مؤشر إلغاء التفعيل: 1 = inactive (XCOU_INACTIVE)']
  Region_Id bigint [note: 'الربط بالمنطقة الجغرافية (XCOU_XREG_ID)']
  Domestic int [note: 'مؤشر الدولة المحلية أو الداخلية (XCOU_DOMESTIC)']
  TouristNumberCycle_Id bigint [note: 'الربط بدورة الأرقام الخاصة بالسياح (XCOU_TOURIST_ZINN_ID)']
}
// جدول إحصائيات وعقود الشركات (كان يسمى XCTH)
Table CorporateContracts {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XCTH_ID)']
  Name varchar(30) [note: 'اسم العقد أو الشركة (XCTH_NAME)']
  RoomNights bigint [note: 'إجمالي عدد ليالي الغرف المرتبطة بالعقد (XCTH_ROOMNIGHTS)']
