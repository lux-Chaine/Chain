  BlockLink_Id bigint [note: 'رابط تعليمات الفوترة بالبلوك أو الكتلة (YBIS_YBLH_ID)']
}
// جدول تفاصيل أو بنود مبيعات الحجوزات أو الكتل (كان يسمى YBSS)
