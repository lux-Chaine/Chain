// جدول مستندات ووثائق الضيوف الشخصية (كان يسمى XPDC)
Table GuestPersonalDocuments {
  Id bigint [pk, note: 'المُعرف الداخلي الفريد (XPDC_ID)']
  DocumentGroupType_Id bigint [not null, note: 'معرف مجموعة أو نوع وثيقة الضيف (XPDC_XPDG_ID)']
  Customer_Id bigint [not null, note: 'معرف العميل أو الضيف المرتبط بالوثيقة (XPDC_XCMS_ID)']
  Name varchar(70) [note: 'اسم الشخص كما يظهر على المستند (XPDC_NAME)']
  Value varchar(30) [note: 'رقم الوثيقة أو جواز السفر (XPDC_VALUE)']
  IssuerCountry_Id bigint [note: 'كود الدولة المعيارية للدولة التي أصدرت المستند (XPDC_XCOU_ID_COUNTRY)']
  NationalityCountry_Id bigint [note: 'كود الدولة المعياري لجنسية الضيف (XPDC_XCOU_ID_NATION)']
